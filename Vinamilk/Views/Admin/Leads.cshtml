@model IEnumerable<Vinamilk.Models.Entities.Lead>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Lead";

    var sortOrder = Context.Request.Query["sort"].ToString();
    var isDesc = sortOrder == "desc";
    var sortedLeads = isDesc
        ? Model.OrderByDescending(x => x.Id)
        : Model.OrderBy(x => x.Id);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-person-lines-fill text-primary me-2"></i>Khách hàng tiềm năng (Leads)
            </h5>
            <small class="text-muted">Thu thập tự động từ Landing Page khuyến mãi 20%</small>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Nút chuyển đổi thứ tự sắp xếp ID -->
            <div class="btn-group btn-group-sm" role="group" aria-label="Sắp xếp Mã">
                <a href="?sort=asc" class="btn @(!isDesc ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-sort-numeric-down me-1"></i>Mã tăng dần (#1 → cuối)
                </a>
                <a href="?sort=desc" class="btn @(isDesc ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-sort-numeric-up-alt me-1"></i>Mã giảm dần (cuối → #1)
                </a>
            </div>

            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">Tổng cộng: @Model.Count() Leads</span>
        </div>
    </div>

    <div class="card-custom">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>
                            <a href="?sort=@(isDesc ? "asc" : "desc")" class="text-decoration-none text-dark d-inline-flex align-items-center gap-1" title="Bấm để đảo thứ tự Mã">
                                <span>Mã</span>
                                <i class="bi @(isDesc ? "bi-arrow-down text-primary" : "bi-arrow-up text-primary")"></i>
                            </a>
                        </th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Lead Score</th>
                        <th>Chỉnh điểm</th>
                        <th>Trạng thái</th>
                        <th>Thời gian đăng ký</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in sortedLeads)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@l.Id</td>
                            <td class="fw-semibold">@l.FullName</td>
                            <td>@l.Email</td>
                            <td>@(string.IsNullOrEmpty(l.PhoneNumber) ? "-" : l.PhoneNumber)</td>
                            <td>
                                <span class="badge @(l.LeadScore >= 30 ? "bg-danger" : "bg-warning text-dark")">
                                    ★ @l.LeadScore điểm
                                </span>
                            </td>
                            <td>
                                <form asp-action="UpdateLeadScore" method="post" class="d-flex align-items-center gap-1">
                                    <input type="hidden" name="id" value="@l.Id" />
                                    <input type="hidden" name="sort" value="@sortOrder" />
                                    <input type="number"
                                           name="leadScore"
                                           value="@l.LeadScore"
                                           min="0"
                                           max="100"
                                           class="form-control form-control-sm text-center fw-semibold"
                                           style="width: 68px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary px-2" title="Lưu điểm">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            </td>
                            <td><span class="badge bg-success bg-opacity-10 text-success">@l.Status</span></td>
                            <td class="text-muted">@l.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>