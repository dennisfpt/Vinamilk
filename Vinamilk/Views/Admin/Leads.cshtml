@model IEnumerable<Vinamilk.Models.Entities.Lead>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Lead";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i>Khách hàng tiềm năng (Leads)</h5>
            <small class="text-muted">Thu thập tự động từ Landing Page khuyến mãi 20%</small>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">Tổng cộng: @Model.Count() Leads</span>
    </div>

    <div class="card-custom">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Lead Score</th>
                        <th>Trạng thái</th>
                        <th>Thời gian đăng ký</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@l.Id</td>
                            <td class="fw-semibold">@l.FullName</td>
                            <td>@l.Email</td>
                            <td>@(string.IsNullOrEmpty(l.PhoneNumber) ? "-" : l.PhoneNumber)</td>
                            <td>
                                <span class="badge @(l.LeadScore >= 30 ? "bg-danger" : "bg-warning text-dark")">
                                    ★ @l.LeadScore điểm
                                </span>
                            </td>
                            <td><span class="badge bg-success bg-opacity-10 text-success">@l.Status</span></td>
                            <td class="text-muted">@l.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>