@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container-fluid">
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-people text-primary me-2"></i>Danh sách khách hàng đăng ký</h5>
    <div class="card-custom">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã User ID</th>
                    <th>Email / Tài khoản</th>
                    <th>Số điện thoại</th>
                    <th>Trạng thái Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="text-muted" style="font-size: 11px;">@u.Id</td>
                        <td class="fw-bold text-dark">@u.UserName</td>
                        <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "Chưa cập nhật" : u.PhoneNumber)</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success">Đang hoạt động</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>