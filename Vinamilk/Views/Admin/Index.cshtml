                            <td class="fw-bold text-dark">Khuyến mãi sữa tươi 100%</td>
                            <td>Email</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success">Hoàn thành</span></td>
                            <td class="fw-bold text-success">68.5%</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-dark">Ưu đãi sữa chua Vinamilk</td>
                            <td>Landing Page</td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">Đang chạy</span></td>
                            <td class="fw-bold text-primary">71.2%</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-dark">Chăm sóc khách hàng</td>
                            <td>Chatbot</td>
                            <td><span class="badge bg-info bg-opacity-10 text-info">Hoạt động</span></td>
                            <td class="fw-bold text-info">92.1%</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-dark">Giới thiệu sản phẩm mới</td>
                            <td>Social Media</td>
                            <td><span class="badge bg-secondary bg-opacity-10 text-secondary">Lên lịch</span></td>
                            <td class="text-muted">-</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT RENDER 3 BIỂU ĐỒ (LINE, DOUGHNUT, BAR) -->
@section Scripts {
    <script>
        // 1. Biểu đồ Doanh thu (Line Chart)
        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: ['29/10', '30/10', '31/10', '01/11', '02/11', '03/11', '04/11'],
                datasets: [{
                    label: 'Doanh thu',
                    data: [42, 60, 58, 80, 78, 120, 105],
                    borderColor: '#0077c8',
                    backgroundColor: 'rgba(0, 119, 200, 0.08)',
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#0077c8',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        ticks: { callback: v => v + 'tr' },
                        grid: { color: '#f0f3f6' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });

        // 2. Biểu đồ Thống kê đơn (Doughnut Chart)
        const ctxOrder = document.getElementById('orderStatusChart').getContext('2d');
        new Chart(ctxOrder, {
            type: 'doughnut',
            data: {
                labels: ['Đã giao', 'Đang xử lý', 'Đã hủy'],
                datasets: [{
                    data: [65, 20, 15],
                    backgroundColor: ['#0077c8', '#fd7e14', '#198754'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                cutout: '72%'
            }
        });

        // 3. Biểu đồ Cột Lead (Bar Chart)
        const ctxLead = document.getElementById('leadsChart').getContext('2d');
        new Chart(ctxLead, {
            type: 'bar',
            data: {
                labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
                datasets: [{
                    data: [25, 32, 48, 55, 68, 72, 80],
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { display: false },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}