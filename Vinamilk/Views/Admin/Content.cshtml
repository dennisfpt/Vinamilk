@model IEnumerable<Vinamilk.Controllers.AdminController.ArticleItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý bài viết & Tin tức";
}

<div class="container-fluid px-4 py-4">
    <!-- TIÊU ĐỀ & NÚT VIẾT BÀI MỚI BẬT MODAL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-text text-primary"></i> Quản lý bài viết & Tin tức Vinamilk
        </h5>
        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 small shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalAddArticle" style="background-color: #0056b3; border-color: #0056b3;">
            <i class="bi bi-plus-circle"></i> Viết bài mới
        </button>
    </div>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 border-0 shadow-sm" style="background-color: #def7ec; color: #03543f;">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- BẢNG DANH SÁCH BÀI VIẾT (CHUẨN HÌNH ẢNH CỦA BẠN) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-borderless align-middle mb-0">
                <thead class="border-bottom">
                    <tr class="text-dark fw-bold small">
                        <th style="width: 45%;">Tiêu đề bài viết</th>
                        <th style="width: 15%;">Chuyên mục</th>
                        <th style="width: 12%;">Người đăng</th>
                        <th style="width: 12%;">Ngày đăng</th>
                        <th style="width: 11%;">Trạng thái</th>
                        <th class="text-end" style="width: 5%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="fw-medium text-dark">@item.Title</td>
                                <td class="text-muted">@item.Category</td>
                                <td class="text-muted">@item.Author</td>
                                <td class="text-muted">@item.PublishDate</td>
                                <td>
                                    <span class="badge rounded-pill px-2 py-1" style="background-color: #0d8a55; font-size: 11px;">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <form asp-action="DeleteArticle" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa bài này?');" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">Chưa có bài viết nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL POPUP VIẾT BÀI MỚI -->
<div class="modal fade" id="modalAddArticle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h6 class="modal-title fw-bold text-dark">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Đăng bài viết & Tin tức mới
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateArticle" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Tiêu đề bài viết *</label>
                        <input type="text" name="title" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="VD: Vinamilk ra mắt dòng sản phẩm Green Farm thuần khiết mới" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Chuyên mục bài viết *</label>
                            <select name="category" class="form-select rounded-3 py-2 small bg-light border-0">
                                <option value="Tin hoạt động">Tin hoạt động</option>
                                <option value="Về chúng tôi">Về chúng tôi</option>
                                <option value="Dinh dưỡng & Sức khỏe">Dinh dưỡng & Sức khỏe</option>
                                <option value="Khuyến mãi Vinamilk">Khuyến mãi Vinamilk</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Ảnh đại diện bài viết (/images/... hoặc URL)</label>
                            <input type="text" name="thumbnail" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="/images/news-banner.jpg" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Tóm tắt ngắn</label>
                        <textarea name="summary" rows="2" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Tóm tắt ngắn gọn nội dung bài viết..."></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Nội dung chi tiết</label>
                        <textarea name="content" rows="4" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Nhập nội dung bài viết..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 py-2 small" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 small fw-bold" style="background-color: #0056b3; border-color: #0056b3;">
                        <i class="bi bi-send me-1"></i> Xuất bản bài viết
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>