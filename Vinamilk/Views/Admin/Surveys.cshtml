@model IEnumerable<Vinamilk.Models.Entities.GreenFarmSurvey>
@using System.Text.Json
@{
    ViewData["Title"] = "Báo cáo Khảo sát Green Farm";
}

<div class="container-fluid py-4">
    <!-- Thống kê tổng quan -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">Phân Tích Khảo Sát Sữa Tươi Green Farm</h3>
            <p class="text-muted small mb-0">Dữ liệu thu thập thực tế từ khách hàng tham gia đánh giá</p>
        </div>
        <div class="card border-0 shadow-sm bg-success text-white px-4 py-3 rounded-4">
            <div class="small opacity-75">Tổng số người khảo sát</div>
            <div class="fs-2 fw-bold">@Model.Count() <span class="fs-6 fw-normal">người</span></div>
        </div>
    </div>

    <!-- Khu vực 3 Biểu đồ phân tích -->
    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="fw-bold text-dark mb-3">1. Cơ cấu Độ tuổi tham gia</h6>
                <canvas id="ageChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="fw-bold text-dark mb-3">2. Dòng Green Farm được ưa chuộng</h6>
                <canvas id="productChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="fw-bold text-dark mb-3">3. Yếu tố quyết định chọn mua</h6>
                <canvas id="reasonChart" style="max-height: 260px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Bảng chi tiết danh sách người đã khảo sát -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h5 class="fw-bold text-dark mb-3">Danh Sách Chi Tiết Người Tham Gia Khảo Sát</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Nhóm tuổi</th>
                        <th>Dòng sữa ưa thích</th>
                        <th>Tần suất</th>
                        <th>Lý do chọn mua</th>
                        <th>Chi phí/tháng</th>
                        <th>Góp ý</th>
                        <th>Thời gian gửi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@(stt++)</td>
                            <td class="fw-semibold text-primary">@item.FullName</td>
                            <td>@item.PhoneNumber</td>
                            <td><span class="badge bg-info-subtle text-info">@item.AgeGroup</span></td>
                            <td class="fw-semibold text-success">@item.PreferredProduct</td>
                            <td>@item.Frequency</td>
                            <td>@item.ReasonToChoose</td>
                            <td>@item.MonthlySpending</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(item.Feedback) ? "—" : item.Feedback)</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Nhúng Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Dữ liệu từ C# Controller
    const ageLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.AgeLabels));
    const ageCounts = @Html.Raw(JsonSerializer.Serialize(ViewBag.AgeCounts));

    const productLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProductLabels));
    const productCounts = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProductCounts));

    const reasonLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ReasonLabels));
    const reasonCounts = @Html.Raw(JsonSerializer.Serialize(ViewBag.ReasonCounts));

    // 1. Biểu đồ tròn - Độ tuổi
    new Chart(document.getElementById('ageChart'), {
        type: 'doughnut',
        data: {
            labels: ageLabels,
            datasets: [{
                data: ageCounts,
                backgroundColor: ['#004b91', '#2e7d32', '#f59e0b', '#6366f1']
            }]
        }
    });

    // 2. Biểu đồ cột - Dòng sản phẩm
    new Chart(document.getElementById('productChart'), {
        type: 'bar',
        data: {
            labels: productLabels,
            datasets: [{
                label: 'Số lượt chọn',
                data: productCounts,
                backgroundColor: '#2e7d32',
                borderRadius: 6
            }]
        },
        options: { plugins: { legend: { display: false } } }
    });

    // 3. Biểu đồ cột ngang - Lý do chọn mua
    new Chart(document.getElementById('reasonChart'), {
        type: 'bar',
        data: {
            labels: reasonLabels,
            datasets: [{
                label: 'Số lượt chọn',
                data: reasonCounts,
                backgroundColor: '#004b91',
                borderRadius: 6
            }]
        },
        options: {
            indexAxis: 'y',
            plugins: { legend: { display: false } }
        }
    });
</script>