@{
    ViewData["Title"] = "Quản lý Khảo sát Green Farm";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                    <i class="bi bi-google me-1"></i> Google Forms Management
                </span>
                <h3 class="fw-bold text-dark mb-1">Quản Trị Khảo Sát Vinamilk Green Farm</h3>
                <p class="text-muted small mb-0">Xem danh sách 30+ phản hồi, biểu đồ thống kê tự động và chỉnh sửa câu hỏi</p>
            </div>

            <!-- Nút mở thẳng trang Quản trị Google Form (như ảnh bạn chụp) -->
            <div class="d-flex gap-2">
                <!-- THAY LINK EDIT GOOGLE FORM CỦA BẠN VÀO ĐÂY -->
                <a href="https://docs.google.com/forms/d/THAY_ID_FORM_CHINH_SUA_CUA_BAN/edit#responses" 
                   target="_blank" 
                   class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm"
                   style="background-color: #673ab7; border-color: #673ab7;">
                    <i class="bi bi-bar-chart-fill me-2"></i> Mở Giao Diện Quản Trị & Biểu Đồ (30 Phản Hồi)
                </a>
            </div>
        </div>

        <hr class="my-4 opacity-10" />

        <!-- Hướng dẫn hoặc nhúng Google Sheets kết quả -->
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-1-circle-fill text-primary me-2"></i>Tab Câu Hỏi</h6>
                    <p class="small text-muted mb-0">Cho phép Admin thêm, sửa, xóa câu hỏi khảo sát trực tiếp trên giao diện Google Forms.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-2-circle-fill text-success me-2"></i>Tab Câu Trả Lời (30)</h6>
                    <p class="small text-muted mb-0">Tự động vẽ biểu đồ tròn, biểu đồ cột cho từng câu hỏi và xem chi tiết từng người trả lời.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-3-circle-fill text-warning me-2"></i>Xuất Google Trang Tính</h6>
                    <p class="small text-muted mb-0">Đồng bộ toàn bộ dữ liệu theo thời gian thực ra file Excel / Google Sheets để tải về báo cáo.</p>
                </div>
            </div>
        </div>
    </div>
</div>