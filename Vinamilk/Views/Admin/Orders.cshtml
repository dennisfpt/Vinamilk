@model IEnumerable<Vinamilk.Models.Entities.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đơn hàng";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container-fluid px-4 py-4">
    <!-- TIÊU ĐỀ & THANH LỌC TRẠNG THÁI -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-cart3 text-primary"></i> Quản lý đơn hàng
            </h5>
            <small class="text-muted">Theo dõi tiến trình đơn hàng, kiểm tra nội dung CK MB Bank và duyệt giao hàng</small>
        </div>

        <!-- BỘ LỌC TAB TRẠNG THÁI BO TRÒN -->
        <div class="d-flex flex-wrap gap-1 bg-white p-1 rounded-pill shadow-sm border">
            <a asp-action="Orders" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-light text-muted border-0")" style="@(string.IsNullOrEmpty(currentStatus) ? "background-color: #004b91;" : "")">
                Tất cả (@Model.Count())
            </a>
            <a asp-action="Orders" asp-route-status="Chờ thanh toán QR" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Chờ thanh toán QR" ? "btn-warning text-dark fw-bold" : "btn-light text-muted border-0")">
                Chờ QR
            </a>
            <a asp-action="Orders" asp-route-status="Đã thanh toán (Chờ xác nhận)" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Đã thanh toán (Chờ xác nhận)" ? "btn-info text-white fw-bold" : "btn-light text-muted border-0")">
                Chờ duyệt MB
            </a>
            <a asp-action="Orders" asp-route-status="Đang xử lý" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Đang xử lý" ? "btn-secondary text-white fw-bold" : "btn-light text-muted border-0")">
                COD Chờ gửi
            </a>
            <a asp-action="Orders" asp-route-status="Đang giao" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Đang giao" ? "btn-primary fw-bold" : "btn-light text-muted border-0")">
                Đang giao
            </a>
            <a asp-action="Orders" asp-route-status="Hoàn thành" class="btn btn-sm rounded-pill px-3 @(currentStatus == "Hoàn thành" ? "btn-success fw-bold" : "btn-light text-muted border-0")">
                Hoàn thành
            </a>
        </div>
    </div>

    <!-- THÔNG BÁO CẬP NHẬT -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 small rounded-3 alert-dismissible fade show border-0 shadow-sm" style="background-color: #def7ec; color: #03543f;">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BẢNG DANH SÁCH ĐƠN HÀNG TRÊN THẺ TRẮNG -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                <thead class="border-bottom text-muted">
                    <tr>
                        <th style="width: 85px;">MÃ ĐƠN</th>
                        <th style="min-width: 170px;">KHÁCH HÀNG</th>
                        <th style="min-width: 220px;">SẢN PHẨM ĐẶT</th>
                        <th style="min-width: 130px;">TỔNG TIỀN</th>
                        <th style="min-width: 160px;">THANH TOÁN & GHI CHÚ</th>
                        <th style="min-width: 140px;">TRẠNG THÁI</th>
                        <th class="text-end" style="min-width: 180px;">THAO TÁC XỬ LÝ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var o in Model)
                        {
                            <tr class="border-bottom">
                                <!-- Mã đơn -->
                                <td>
                                    <span class="fw-bold text-primary">#@o.Id</span>
                                    <span class="text-muted d-block" style="font-size: 11px;">@o.CreatedAt.ToString("dd/MM HH:mm")</span>
                                </td>

                                <!-- Khách hàng -->
                                <td>
                                    <div class="fw-bold text-dark">@o.CustomerName</div>
                                    <div class="text-primary small"><i class="bi bi-telephone me-1"></i>@o.PhoneNumber</div>
                                    <div class="text-muted text-truncate" style="max-width: 200px; font-size: 11px;" title="@o.Address">
                                        <i class="bi bi-geo-alt me-1"></i>@o.Address
                                    </div>
                                </td>

                                <!-- Danh sách sản phẩm -->
                                <td>
                                    @if (o.OrderItems != null && o.OrderItems.Any())
                                    {
                                        foreach (var item in o.OrderItems)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="text-truncate" style="max-width: 170px;">• @(item.Product?.Name ?? "Sản phẩm")</span>
                                                <span class="badge bg-light text-dark border">x@item.Quantity</span>
                                            </div>
                                        }
                                    }
                                </td>

                                <!-- Tổng tiền -->
                                <td>
                                    <span class="fw-bold fs-6" style="color: #004b91;">@o.TotalAmount.ToString("N0")đ</span>
                                </td>

                                <!-- Phương thức & Ghi chú (Mã CK VietQR) -->
                                <td>
                                    @if (o.PaymentMethod == "Banking")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mb-1">
                                            <i class="bi bi-qr-code me-1"></i>QR MB Bank
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border mb-1">
                                            <i class="bi bi-cash-stack me-1"></i>COD Khi nhận
                                        </span>
                                    }
                                    <div class="text-danger fw-semibold" style="font-size: 11px;">@o.Note</div>
                                </td>

                                <!-- Trạng thái -->
                                <td>
                                    @if (o.Status == "Chờ thanh toán QR")
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark px-2 py-1">Chờ khách quét QR</span>
                                    }
                                    else if (o.Status == "Đã thanh toán (Chờ xác nhận)")
                                    {
                                        <span class="badge rounded-pill bg-info text-white px-2 py-1">Khách báo đã CK</span>
                                    }
                                    else if (o.Status == "Đang giao")
                                    {
                                        <span class="badge rounded-pill bg-primary px-2 py-1">Đang giao hàng</span>
                                    }
                                    else if (o.Status == "Hoàn thành")
                                    {
                                        <span class="badge rounded-pill bg-success px-2 py-1">Đã hoàn tất</span>
                                    }
                                    else if (o.Status == "Đã hủy")
                                    {
                                        <span class="badge rounded-pill bg-danger px-2 py-1">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary px-2 py-1">@o.Status</span>
                                    }
                                </td>

                                <!-- Thao tác đổi trạng thái nhanh -->
                                <td class="text-end">
                                    <form asp-action="UpdateOrderStatus" method="post" class="d-inline-flex gap-1 justify-content-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <select name="newStatus" class="form-select form-select-sm rounded-pill" style="font-size: 11px; width: 140px;">
                                            <option value="Đã thanh toán (Chờ xác nhận)" selected="@(o.Status.Contains("Chờ xác nhận"))">Duyệt đã nhận tiền</option>
                                            <option value="Đang giao" selected="@(o.Status == "Đang giao")">Đang giao hàng</option>
                                            <option value="Hoàn thành" selected="@(o.Status == "Hoàn thành")">Hoàn thành đơn</option>
                                            <option value="Đã hủy" selected="@(o.Status == "Đã hủy")">Hủy đơn hàng</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #004b91; border-color: #004b91;" title="Cập nhật">
                                            <i class="bi bi-check-lg" style="font-size: 13px;"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted small">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không tìm thấy đơn hàng nào ở mục này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>