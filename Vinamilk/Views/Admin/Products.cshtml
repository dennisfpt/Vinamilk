@model IEnumerable<Vinamilk.Models.Entities.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý danh mục sản phẩm";
    var categories = ViewBag.Categories as List<Vinamilk.Models.Entities.Category> ?? new();
}

<div class="container-fluid px-4 py-4">
    <!-- TIÊU ĐỀ & NÚT THÊM SẢN PHẨM -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold text-dark mb-1">Quản lý danh mục sản phẩm</h5>
            <small class="text-muted">Danh sách sản phẩm đang mở bán trên hệ thống cửa hàng</small>
        </div>
        <!-- Nút Thêm sản phẩm bật Modal -->
        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 small shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalAddProduct" style="background-color: #004b91; border-color: #004b91;">
            <i class="bi bi-plus-lg"></i> Thêm sản phẩm
        </button>
    </div>

    <!-- THÔNG BÁO KẾT QUẢ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 small rounded-3 alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2 px-3 small rounded-3 alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BẢNG DANH SÁCH SẢN PHẨM -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-uppercase small fw-bold text-secondary border-bottom">
                    <tr>
                        <th style="width: 80px;">ẢNH</th>
                        <th>TÊN SẢN PHẨM</th>
                        <th style="width: 150px;">GIÁ BÁN</th>
                        <th style="width: 180px;">DANH MỤC</th>
                        <th class="text-end" style="width: 120px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" alt="@item.Name" class="rounded p-1 border" style="width: 48px; height: 48px; object-fit: contain;" />
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark small">@item.Name</span>
                                    <span class="text-muted d-block" style="font-size: 11px;">Tồn kho: @item.StockQuantity</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary small">@item.Price.ToString("N0")đ</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border fw-normal px-2 py-1" style="font-size: 11px;">
                                        @(item.Category?.Name ?? "Chung")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Nút Sửa -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" data-bs-toggle="modal" data-bs-target="#modalEditProduct-@item.Id" title="Chỉnh sửa">
                                            <i class="bi bi-pencil" style="font-size: 13px;"></i>
                                        </button>

                                        <!-- Nút Xóa -->
                                        <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm: @item.Name?');" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" title="Xóa">
                                                <i class="bi bi-trash" style="font-size: 13px;"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- MODAL SỬA SẢN PHẨM RIÊNG CỦA MÓN NÀY -->
                                    <div class="modal fade text-start" id="modalEditProduct-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <h6 class="modal-title fw-bold text-dark">
                                                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa sản phẩm
                                                    </h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="EditProduct" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <div class="modal-body py-3">
                                                        <div class="mb-3">
                                                            <label class="form-label small text-muted mb-1">Tên sản phẩm *</label>
                                                            <input type="text" name="name" class="form-control rounded-3 py-2 small bg-light border-0" value="@item.Name" required />
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-6">
                                                                <label class="form-label small text-muted mb-1">Danh mục *</label>
                                                                <select name="categoryId" class="form-select rounded-3 py-2 small bg-light border-0" required>
                                                                    @foreach (var c in categories)
                                                                    {
                                                                        <option value="@c.Id" selected="@(c.Id == item.CategoryId)">@c.Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="form-label small text-muted mb-1">Đơn giá (VNĐ) *</label>
                                                                <input type="number" name="price" class="form-control rounded-3 py-2 small bg-light border-0" value="@Convert.ToInt64(item.Price)" required />
                                                            </div>
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-6">
                                                                <label class="form-label small text-muted mb-1">Đường dẫn ảnh</label>
                                                                <input type="text" name="imageUrl" class="form-control rounded-3 py-2 small bg-light border-0" value="@item.ImageUrl" required />
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="form-label small text-muted mb-1">Tồn kho</label>
                                                                <input type="number" name="stockQuantity" class="form-control rounded-3 py-2 small bg-light border-0" value="@item.StockQuantity" required />
                                                            </div>
                                                        </div>
                                                        <div class="mb-2">
                                                            <label class="form-label small text-muted mb-1">Mô tả ngắn</label>
                                                            <textarea name="shortDescription" rows="2" class="form-control rounded-3 py-2 small bg-light border-0">@item.ShortDescription</textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-3 py-2 small" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 small fw-bold">Cập nhật</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small">
                                Chưa có sản phẩm nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM SẢN PHẨM MỚI -->
<div class="modal fade" id="modalAddProduct" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h6 class="modal-title fw-bold text-dark" id="modalLabel">
                    <i class="bi bi-box-seam text-primary me-2"></i>Thêm sản phẩm Vinamilk mới
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="CreateProduct" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Tên sản phẩm *</label>
                        <input type="text" name="name" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="VD: Sữa Chua Uống Vinamilk Probi Có Đường 130ml" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Danh mục *</label>
                            <select name="categoryId" class="form-select rounded-3 py-2 small bg-light border-0" required>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Đơn giá (VNĐ) *</label>
                            <input type="number" name="price" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="32000" min="1000" step="500" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Ảnh (URL hoặc /images/...)</label>
                            <input type="text" name="imageUrl" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Dán link ảnh tại đây" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Số lượng tồn kho</label>
                            <input type="number" name="stockQuantity" class="form-control rounded-3 py-2 small bg-light border-0" value="100" min="1" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Mô tả ngắn</label>
                        <textarea name="shortDescription" rows="2" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Sữa chua uống men sống Probi..."></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="isFeat" checked />
                        <label class="form-check-label small text-muted" for="isFeat">Hiển thị nổi bật ở Trang chủ</label>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 py-2 small" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 small fw-bold">
                        <i class="bi bi-save me-1"></i> Lưu sản phẩm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>