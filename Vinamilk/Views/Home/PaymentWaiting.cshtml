@model Vinamilk.Models.Entities.Order
@{
    ViewData["Title"] = "Thanh toán đơn hàng #" + Model.Id;
}

<div class="container py-5" style="max-width: 650px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
        <!-- TIÊU ĐỀ TRẠNG THÁI CHỜ -->
        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-clock-history fs-2"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Chờ thanh toán chuyển khoản</h5>
        <p class="text-muted small">Vui lòng quét mã QR bên dưới bằng app ngân hàng để hoàn tất đơn hàng <b>#@Model.Id</b></p>

        <!-- KHUNG MÃ QR MB BANK -->
        <div class="border border-primary border-opacity-25 bg-light rounded-4 p-3 my-2">
            <span class="badge bg-primary rounded-pill px-3 py-1 mb-2">Mã VietQR MB Bank tự động</span>
            
            <div class="my-2 d-flex justify-content-center">
    <img src="@ViewBag.QrUrl" 
         alt="Mã VietQR MB Bank" 
         class="img-fluid rounded-3 shadow-sm border bg-white p-2" 
         style="max-width: 260px; width: 100%; height: auto; display: block;" 
         onerror="this.onerror=null; this.src='https://api.qrserver.com/v1/create-qr-code/?size=260x260&data=@(Uri.EscapeDataString($"2|99|0865156242|MB||0|0|{Convert.ToInt64(Model.TotalAmount)}|{ViewBag.PaymentCode}"))';" />
</div>

            <div class="text-start bg-white p-3 rounded-3 small border mt-2">
                <p class="mb-1"><b>Ngân hàng:</b> MB Bank (Ngân hàng Quân Đội)</p>
                <p class="mb-1"><b>Số tài khoản:</b> <span class="fw-bold text-primary">0865156242</span></p>
                <p class="mb-1"><b>Số tiền:</b> <span class="fw-bold text-danger fs-6">@Model.TotalAmount.ToString("N0")đ</span></p>
                <p class="mb-0"><b>Nội dung chuyển khoản:</b> <span class="badge bg-warning text-dark fs-6 px-2">@ViewBag.PaymentCode</span></p>
            </div>
            <small class="text-danger d-block mt-2" style="font-size: 11px;">
                <i class="bi bi-exclamation-circle me-1"></i>Vui lòng giữ nguyên nội dung chuyển khoản để hệ thống ghi nhận đúng đơn của bạn.
            </small>
        </div>

        <!-- FORM XÁC NHẬN ĐÃ CHUYỂN KHOẢN -->
        <form asp-action="ConfirmPayment" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Id" />
            <button type="submit" class="btn btn-vnm w-100 py-2 shadow-sm rounded-pill fw-bold">
                <i class="bi bi-check2-circle me-1"></i> Tôi đã chuyển khoản xong
            </button>
        </form>

        <div class="mt-3">
            <a asp-action="Profile" class="small text-muted text-decoration-none">Thanh toán sau & xem trong Lịch sử đơn hàng &rarr;</a>
        </div>
    </div>
</div>