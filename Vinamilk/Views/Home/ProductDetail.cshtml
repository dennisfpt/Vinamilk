@model Vinamilk.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as List<Vinamilk.Models.Entities.Product> ?? new();
    var images360 = ViewBag.Product360Images as List<string> ?? new List<string> { Model.ImageUrl ?? "" };
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng Màn 3 -->
    <nav class="small mb-4 text-muted">
        <a asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a> &gt; 
        <a asp-action="Products" class="text-decoration-none text-muted">Sản phẩm</a> &gt; 
        <span class="text-dark fw-medium">@Model.Name</span>
    </nav>

    <div class="row g-4 bg-white p-4 rounded-4 shadow-sm mb-5">
        <!-- Cột trái: Khung trải nghiệm 3D sạch sẽ (không nút bấm, không thanh trượt) -->
        <div class="col-md-5 text-center position-relative d-flex flex-column justify-content-center align-items-center p-3 rounded-4" 
             id="box-360-viewer" 
             style="background: radial-gradient(circle, #ffffff 65%, #f8fafc 100%); min-height: 440px; cursor: grab; perspective: 1000px;">
            
            <!-- Vùng hiển thị ảnh xoay & chiều sâu 3D -->
            <div class="my-auto position-relative" style="user-select: none;">
                <img id="product-frame-img" 
                     src="@Model.ImageUrl" 
                     alt="@Model.Name" 
                     class="img-fluid rounded-3" 
                     style="max-height: 340px; object-fit: contain; filter: drop-shadow(0 16px 18px rgba(0,0,0,0.14)); -webkit-user-drag: none; transform-style: preserve-3d; transition: transform 0.1s ease-out;" />
                
                <!-- Bóng đổ sàn theo góc quay -->
                <div id="product-ground-shadow" style="width: 170px; height: 14px; background: radial-gradient(ellipse at center, rgba(0,0,0,0.24) 0%, rgba(0,0,0,0) 75%); margin: 12px auto 0; border-radius: 50%; transition: transform 0.15s ease-out;"></div>
            </div>
        </div>

        <!-- Cột phải: Chi tiết thông tin sản phẩm -->
        <div class="col-md-7">
            <h4 class="fw-bold text-dark mb-1">@Model.Name</h4>
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="text-warning small"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span>
                <span class="small text-muted">(4.9 | 2.5k đánh giá)</span>
            </div>

            <h3 class="fw-bold mb-3" style="color: #004b91;">@Model.Price.ToString("N0")đ</h3>

            <!-- 3 Cam kết tiêu chuẩn Vinamilk -->
            <ul class="list-unstyled small mb-4">
                <li class="mb-2 text-success fw-medium"><i class="bi bi-check-circle-fill me-2"></i>100% sữa tươi nguyên chất</li>
                <li class="mb-2 text-success fw-medium"><i class="bi bi-check-circle-fill me-2"></i>Giàu canxi, vitamin D</li>
                <li class="text-success fw-medium"><i class="bi bi-check-circle-fill me-2"></i>Tốt cho xương và trí não</li>
            </ul>

            <!-- Form Đặt hàng gồm số lượng + Thêm vào giỏ + Mua ngay -->
            <form asp-action="AddToCart" method="post" id="product-action-form" class="d-flex flex-wrap align-items-center gap-3 mb-4">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="input-group" style="width: 120px;">
                    <input type="number" id="order-quantity" name="quantity" value="1" min="1" max="99" class="form-control text-center rounded-pill" />
                </div>
                <button type="submit" class="btn btn-outline-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                </button>
                <button type="submit" formaction="@Url.Action("BuyNow", "Home")" class="btn btn-vnm rounded-pill px-4 py-2 shadow-sm fw-semibold" style="background-color: #004b91;">
                    <i class="bi bi-lightning-fill me-1"></i> Mua ngay
                </button>
            </form>

            <div class="small text-muted pt-3 border-top">
                <i class="bi bi-shield-check text-primary me-1"></i> Cam kết sản phẩm chính hãng Vinamilk Việt Nam
            </div>
        </div>
    </div>

    <!-- Thông tin dinh dưỡng chi tiết -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-5">
        <h6 class="fw-bold text-dark border-bottom pb-2">Thông tin dinh dưỡng chi tiết</h6>
        <p class="small text-secondary mb-2">@(string.IsNullOrEmpty(Model.ShortDescription) ? "Sữa tươi Vinamilk 100% được làm từ sữa tươi nguyên chất, giàu dưỡng chất tự nhiên, mang lại nguồn năng lượng thuần khiết mỗi ngày cho cả gia đình." : Model.ShortDescription)</p>
        <p class="small text-muted mb-0"><b>Thành phần & Dinh dưỡng:</b> @(string.IsNullOrEmpty(Model.NutritionInfo) ? "100% sữa bò tươi, Canxi, Vitamin A, D3, Selen hỗ trợ tăng cường hệ miễn dịch và giúp xương chắc khỏe." : Model.NutritionInfo)</p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const viewerBox = document.getElementById("box-360-viewer");
            const productImg = document.getElementById("product-frame-img");
            const shadow = document.getElementById("product-ground-shadow");

            // Danh sách ảnh xoay truyền từ Controller
            const frames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(images360));
            if (!viewerBox || !productImg || !frames || frames.length <= 1) return;

            let currentIdx = 0;
            let isDragging = false;
            let startX = 0;

            function setFrame(idx) {
                currentIdx = (idx + frames.length) % frames.length;
                productImg.src = frames[currentIdx];
            }

            // 1. Tương tác 3D nổi khối theo góc rê chuột
            viewerBox.addEventListener("mousemove", function (e) {
                if (isDragging) return;
                const rect = viewerBox.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;

                const rotateY = (x / (rect.width / 2)) * 18;
                const rotateX = -(y / (rect.height / 2)) * 14;

                productImg.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.05)`;
                if (shadow) {
                    shadow.style.transform = `translateX(${x * 0.12}px) scale(${1 - Math.abs(x) * 0.0008})`;
                }
            });

            viewerBox.addEventListener("mouseleave", function () {
                if (!isDragging) {
                    productImg.style.transform = "rotateX(0deg) rotateY(0deg) scale(1)";
                    if (shadow) shadow.style.transform = "translateX(0px) scale(1)";
                }
            });

            // 2. Nhấp giữ và kéo chuột trái qua lại để xoay đổi mặt sản phẩm
            viewerBox.addEventListener("mousedown", (e) => {
                isDragging = true;
                startX = e.clientX;
                viewerBox.style.cursor = "grabbing";
            });

            window.addEventListener("mouseup", () => {
                if (isDragging) {
                    isDragging = false;
                    viewerBox.style.cursor = "grab";
                    productImg.style.transform = "rotateX(0deg) rotateY(0deg) scale(1)";
                    if (shadow) shadow.style.transform = "translateX(0px) scale(1)";
                }
            });

            window.addEventListener("mousemove", (e) => {
                if (!isDragging) return;
                const deltaX = e.clientX - startX;

                // Tạo độ nghiêng nhẹ khi đang kéo để tạo cảm giác xoay thật
                const tiltAngle = Math.max(-20, Math.min(20, deltaX * 0.4));
                productImg.style.transform = `rotateY(${tiltAngle}deg) scale(1.06)`;

                if (Math.abs(deltaX) > 28) {
                    if (deltaX > 0) setFrame(currentIdx + 1);
                    else setFrame(currentIdx - 1);
                    startX = e.clientX;
                }
            });

            // 3. Lăn bánh xe chuột để đổi góc ảnh
            viewerBox.addEventListener("wheel", (e) => {
                e.preventDefault();
                if (e.deltaY > 0) setFrame(currentIdx + 1);
                else setFrame(currentIdx - 1);
            });
        });
    </script>
}