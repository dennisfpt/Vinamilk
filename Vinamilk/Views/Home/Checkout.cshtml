@{
    ViewData["Title"] = "Tiến hành đặt hàng";
    var cart = ViewBag.Cart as List<Vinamilk.Models.Entities.CartItem> ?? new();
}

<div class="container py-4" style="max-width: 950px;">
    <!-- 3 BƯỚC BREADCRUMB THEO MÀN 6 -->
    <div class="d-flex justify-content-center align-items-center gap-4 mb-4 small">
        <div class="d-flex align-items-center gap-2 text-primary fw-bold">
            <span class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">1</span>
            <span>Thông tin giao hàng</span>
        </div>
        <div class="text-muted">------</div>
        <div class="d-flex align-items-center gap-2 text-muted">
            <span class="rounded-circle bg-light text-muted border d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">2</span>
            <span>Thanh toán</span>
        </div>
        <div class="text-muted">------</div>
        <div class="d-flex align-items-center gap-2 text-muted">
            <span class="rounded-circle bg-light text-muted border d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">3</span>
            <span>Hoàn tất</span>
        </div>
    </div>

    <form asp-action="ProcessCheckout" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- CỘT TRÁI: FORM ĐIỀN THÔNG TIN GIAO HÀNG & CHỌN PHƯƠNG THỨC -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3">Thông tin giao hàng</h6>
                    
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Họ và tên người nhận *</label>
                        <input type="text" name="fullName" class="form-control rounded-3 py-2 bg-light border-0 small" placeholder="Nguyễn Văn An" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Số điện thoại *</label>
                        <input type="tel" name="phoneNumber" class="form-control rounded-3 py-2 bg-light border-0 small" placeholder="0912345678" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Địa chỉ nhận hàng *</label>
                        <input type="text" name="address" class="form-control rounded-3 py-2 bg-light border-0 small" placeholder="Số 123 Đường ABC, Phường X, Quận Y, TP.HCM" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Ghi chú đơn hàng (nếu có)</label>
                        <textarea name="note" rows="2" class="form-control rounded-3 py-2 bg-light border-0 small" placeholder="Ghi chú thêm về thời gian giao hoặc địa điểm nhận hàng..."></textarea>
                    </div>

                    <!-- KHỐI PHƯƠNG THỨC THANH TOÁN (COD & QUÉT MÃ MB BANK) -->
                    <h6 class="fw-bold text-dark mt-4 mb-2">Phương thức thanh toán</h6>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD" checked>
                        <label class="form-check-label small" for="cod">
                            <i class="bi bi-cash-stack text-success me-1"></i> Thanh toán khi nhận hàng (COD)
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="banking" value="Banking">
                        <label class="form-check-label small" for="banking">
                            <i class="bi bi-qr-code-scan text-primary me-1"></i> Chuyển khoản MB Bank (Tự động tạo mã QR VietQR)
                        </label>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: ĐƠN HÀNG CỦA BẠN & TỔNG TIỀN -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3">Đơn hàng của bạn</h6>

                    <div class="mb-3">
                        @foreach (var item in cart)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 small">
                                <div>
                                    <span class="fw-medium text-dark">@item.ProductName</span>
                                    <span class="text-muted d-block" style="font-size: 11px;">SL: @item.Quantity</span>
                                </div>
                                <span class="fw-bold text-dark">@item.Total.ToString("N0")đ</span>
                            </div>
                        }
                    </div>

                    <div class="border-top pt-2 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tạm tính:</span>
                            <span>@ViewBag.SubTotal.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span>@ViewBag.ShippingFee.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 border-top pt-2 text-dark">
                            <span>Tổng cộng:</span>
                            <span style="color: #004b91;">@ViewBag.GrandTotal.ToString("N0")đ</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-vnm w-100 py-2 mt-4 shadow-sm">
                        Đặt hàng ngay
                    </button>
                    <div class="text-center mt-2">
                        <a asp-action="Cart" class="small text-muted text-decoration-none">&larr; Quay lại giỏ hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>