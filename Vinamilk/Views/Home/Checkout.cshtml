@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var cart = ViewBag.Cart as IEnumerable<dynamic> ?? new List<dynamic>();
    decimal subTotal = ViewBag.SubTotal ?? 0m;
    decimal shippingFee = ViewBag.ShippingFee ?? 15000m;
    decimal grandTotal = ViewBag.GrandTotal ?? (subTotal + shippingFee);
}

<div class="container py-4">
    <nav class="small mb-4 text-muted">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a> &gt; 
        <a asp-controller="Home" asp-action="Cart" class="text-decoration-none text-muted">Giỏ hàng</a> &gt; 
        <span class="text-dark fw-medium">Thanh toán</span>
    </nav>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <form asp-controller="Home" asp-action="ProcessCheckout" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Cột thông tin nhận hàng -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold text-dark border-bottom pb-3 mb-4">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>Thông tin người nhận
                    </h5>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: Nguyễn Văn A" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Số điện thoại (10 chữ số, bắt đầu bằng 0) <span class="text-danger">*</span></label>
                        <input type="tel" name="phoneNumber" class="form-control rounded-pill px-3 py-2" placeholder="0901234567" maxlength="10" pattern="[0-9]{10}" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Địa chỉ giao hàng chi tiết <span class="text-danger">*</span></label>
                        <input type="text" name="address" class="form-control rounded-pill px-3 py-2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Ghi chú giao hàng</label>
                        <textarea name="note" class="form-control rounded-4 px-3 py-2" rows="2" placeholder="Ghi chú thêm nếu có..."></textarea>
                    </div>

                    <h5 class="fw-bold text-dark border-bottom pb-3 my-4">
                        <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>Phương thức thanh toán
                    </h5>

                    <div class="form-check p-3 border rounded-3 mb-2">
                        <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="payCOD" value="COD" checked>
                        <label class="form-check-label fw-semibold text-dark" for="payCOD">
                            <i class="bi bi-cash-coin text-success me-2 fs-5"></i>Thanh toán khi nhận hàng (COD)
                        </label>
                    </div>

                    <div class="form-check p-3 border rounded-3">
                        <input class="form-check-input ms-0 me-3" type="radio" name="paymentMethod" id="payBank" value="Banking">
                        <label class="form-check-label fw-semibold text-dark" for="payBank">
                            <i class="bi bi-qr-code text-primary me-2 fs-5"></i>Chuyển khoản VietQR (Ngân hàng Quân đội MB)
                        </label>
                    </div>
                </div>
            </div>

            <!-- Cột tóm tắt đơn hàng -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                        <i class="bi bi-bag-check-fill text-primary me-2"></i>Đơn hàng của bạn
                    </h5>

                    <div class="mb-3" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in cart)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: contain;" class="rounded border p-1" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small text-dark text-truncate" style="max-width: 200px;">@item.ProductName</div>
                                    <div class="text-muted small">@(((decimal)item.Price).ToString("N0"))đ x @item.Quantity</div>
                                </div>
                                <div class="fw-bold text-primary small">
                                    @(((decimal)(item.Price * item.Quantity)).ToString("N0"))đ
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between small text-secondary mb-2">
                        <span>Tạm tính:</span>
                        <span class="fw-semibold">@subTotal.ToString("N0")đ</span>
                    </div>

                    <div class="d-flex justify-content-between small text-secondary mb-3">
                        <span>Phí vận chuyển:</span>
                        <span class="fw-semibold">@shippingFee.ToString("N0")đ</span>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3 mb-4">
                        <span class="fw-bold text-dark fs-5">Tổng cộng:</span>
                        <span class="fw-bold text-danger fs-5">@grandTotal.ToString("N0")đ</span>
                    </div>

                    <button type="submit" class="btn rounded-pill w-100 py-3 shadow fw-bold text-white fs-6" style="background-color: #004b91;">
                        <i class="bi bi-check2-circle me-1"></i> XÁC NHẬN ĐẶT HÀNG
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>