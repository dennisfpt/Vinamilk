@model IEnumerable<Vinamilk.Models.Entities.Product>
@{
    ViewData["Title"] = "Tết Khoẻ Re - Vinamilk Khuyến Mãi";
    bool isCampaignActive = ViewBag.IsCampaignActive is bool active && active;
    int discountPercent = ViewBag.DiscountPercent != null ? (int)ViewBag.DiscountPercent : 30;
    string voucherCode = ViewBag.VoucherCode as string ?? "TETKHOERE";
}

<style>
    .tet-wrapper {
        position: relative;
        background-color: #FFFFF1;
        overflow-x: hidden;
    }

    /* 1. ẢNH POSTER GỐC + CÁC VÙNG NÚT BẤM TƯƠNG TÁC TRÊN ẢNH */
    .tet-poster-container {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        box-shadow: 0 10px 40px rgba(139, 0, 0, 0.12);
        background: #FFFFF1;
        overflow: hidden; 

    .tet-poster-img {
        width: 100%;
        height: auto;
        display: block;
        margin-bottom: -18.5%; 
    }

    .poster-hotspot {
        position: absolute;
        display: block;
        cursor: pointer;
        border-radius: 999px;
        transition: box-shadow 0.2s ease, background-color 0.2s ease;
        z-index: 5;
    }

    .poster-hotspot:hover {
        background-color: rgba(255, 215, 0, 0.18);
        box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.75);
    }

    /* 2. KHỐI BỐC 2 BAO LÌ XÌ MAY MẮN */
    .lixi-overlay-section {
        background: linear-gradient(180deg, #FFF3D6 0%, #FFFFF1 100%);
        border-top: 3px dashed #D9232E;
        border-bottom: 3px dashed #D9232E;
        padding: 48px 16px;
        position: relative;
        z-index: 10;
    }

    .lixi-envelope {
        width: 215px;
        height: 300px;
        background: linear-gradient(160deg, #E31837 0%, #9E0B22 100%);
        border: 3px solid #FFD700;
        border-radius: 18px;
        position: relative;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(168, 9, 34, 0.3);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 22px 14px;
        user-select: none;
        overflow: hidden;
    }

    .lixi-envelope::before {
        content: "";
        position: absolute;
        top: -45px;
        left: -10%;
        width: 120%;
        height: 112px;
        background: #B80B26;
        border-bottom: 3px solid #FFD700;
        border-radius: 50%;
    }

    .lixi-envelope:hover:not(.opened):not(.disabled) {
        transform: translateY(-10px) rotate(-2deg);
        box-shadow: 0 18px 36px rgba(200, 16, 46, 0.45);
    }

    .lixi-seal {
        width: 66px;
        height: 66px;
        background: radial-gradient(circle, #FFF066 0%, #FFB800 100%);
        border: 3px solid #FFF8DC;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        color: #8B0000;
        font-size: 1.2rem;
        z-index: 2;
        margin-top: 26px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }

    .lixi-envelope.disabled {
        opacity: 0.52;
        cursor: not-allowed;
        filter: grayscale(0.3);
    }

    .lixi-envelope.opened {
        background: linear-gradient(180deg, #FFFDF0 0%, #FFEFA8 100%);
        border-color: #D9232E;
        color: #8B0000;
        transform: scale(1.04);
    }

    .lixi-envelope.opened::before {
        background: #E31837;
    }

    /* 3. FORM ĐĂNG KÝ CHUẨN GIAO DIỆN VINAMILK */
    .vnm-reg-section {
        background-color: #FFFFF1;
        padding: 56px 16px 64px;
        color: #0213B0;
    }

    .vnm-reg-benefits {
        background-color: #D9F2F4;
        border-radius: 6px;
        padding: 16px 20px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    @@media (max-width: 768px) {
        .vnm-reg-benefits {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .vnm-benefit-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #0213B0;
        line-height: 1.3;
    }

    .vnm-benefit-item i {
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .vnm-input-group {
        position: relative;
        margin-bottom: 16px;
    }

    .vnm-underline-input {
        width: 100%;
        background-color: #EBF0F7;
        border: none;
        border-bottom: 2px solid #0213B0;
        border-radius: 4px 4px 0 0;
        padding: 15px 44px 15px 16px;
        font-size: 0.95rem;
        color: #0213B0;
        outline: none;
        transition: background-color 0.2s ease;
    }

    .vnm-underline-input::placeholder {
        color: rgba(2, 19, 176, 0.72);
        font-weight: 500;
    }

    .vnm-underline-input:focus {
        background-color: #E2E9F3;
    }

    .vnm-eye-btn {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #0213B0;
        font-size: 1.15rem;
        cursor: pointer;
        padding: 4px;
    }

    .btn-vnm-submit-reg {
        background-color: #0213B0;
        color: #ffffff;
        font-weight: 700;
        font-size: 1rem;
        padding: 15px 32px;
        border: none;
        border-radius: 6px;
        width: 100%;
        transition: background-color 0.2s ease, transform 0.15s ease;
    }

    .btn-vnm-submit-reg:hover {
        background-color: #000d80;
        transform: translateY(-1px);
    }

    /* 4. HIỆU ỨNG HOA MAI VÀNG RƠI & PHÁO HOA */
    #mai-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9990;
    }

    #fireworks-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9999;
    }

    /* 5. ĐÀN BÒ SỮA CHẠY VÒNG VÒNG (CHỮ LUÔN ĐÚNG CHIỀU ĐỌC) */
    .cow-parade-track {
        position: fixed;
        bottom: 10px;
        left: 0;
        width: 100%;
        height: 64px;
        pointer-events: none;
        z-index: 9985;
        overflow: hidden;
    }

    .running-cow {
        position: absolute;
        bottom: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 2.3rem;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2));
        animation: cowRunLeftToRight 16s linear infinite, cowBounce 0.45s ease-in-out infinite alternate;
    }

    .cow-flip {
        display: inline-block;
        transform: scaleX(-1);
    }

    .running-cow.cow-2 {
        animation-duration: 21s, 0.5s;
        animation-delay: -7s, 0s;
        font-size: 2rem;
    }

    .running-cow.cow-3 {
        animation-name: cowRunRightToLeft, cowBounce;
        animation-duration: 18s, 0.42s;
        animation-delay: -3s, 0s;
    }

    .cow-milk-badge {
        background: #0213B0;
        color: #FFD700;
        font-size: 11px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 12px;
        border: 1.5px solid #FFD700;
        white-space: nowrap;
        direction: ltr;
    }

    @@keyframes cowRunLeftToRight {
        0%   { left: -220px; }
        100% { left: calc(100vw + 220px); }
    }

    @@keyframes cowRunRightToLeft {
        0%   { left: calc(100vw + 220px); }
        100% { left: -220px; }
    }

    @@keyframes cowBounce {
        from { margin-bottom: 0px; }
        to   { margin-bottom: 9px; }
    }
</style>

<!-- Canvas Hoa Mai Rơi & Pháo Hoa -->
<canvas id="mai-canvas"></canvas>
<canvas id="fireworks-canvas"></canvas>

<!-- Đàn bò sữa Vinamilk chạy tung tăng đón Tết -->
<div class="cow-parade-track" aria-hidden="true">
    <div class="running-cow cow-1">
        <span class="cow-milk-badge">Tết Khoẻ Re!</span><span class="cow-flip">🐄</span>
    </div>
    <div class="running-cow cow-2">
        <span class="cow-milk-badge">Vinamilk 100%</span><span class="cow-flip">🐮</span>
    </div>
    <div class="running-cow cow-3">
        <span>🐄</span><span class="cow-milk-badge">Lì Xì Tết!</span>
    </div>
</div>

<div class="tet-wrapper">
    <!-- Thông báo kết quả gửi form -->
    <div class="container pt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-4 shadow-sm fw-semibold mb-2">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger rounded-4 shadow-sm fw-semibold mb-2">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            </div>
        }
    </div>

    <!-- ========================================================= -->
    <!-- KHỐI BỐC 2 BAO LÌ XÌ MAY MẮN + PHÁO HOA                   -->
    <!-- ========================================================= -->
    <section id="boc-li-xi" class="lixi-overlay-section">
        <div class="container text-center">
            <span class="badge bg-danger rounded-pill px-3 py-2 mb-2">
                <i class="bi bi-fire me-1"></i> LỘC XUÂN VINAMILK TẾT KHOẺ RE
            </span>
            <h2 class="fw-bold display-6 mb-2" style="color: #B80B26;">Bốc Bao Lì Xì Nhận Lộc Đầu Năm</h2>
            <p class="text-muted mb-4">
                Chọn <strong>1 trong 2 bao lì xì</strong> để bốc ngẫu nhiên từ <strong>0đ đến 100.000đ</strong>!
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-4 my-3">
                <div class="lixi-envelope" id="lixi-1" onclick="openLixi(1)">
                    <div class="lixi-seal">LỘC</div>
                    <div class="z-2 text-center mt-2">
                        <div class="fw-bold text-warning fs-5">BAO LÌ XÌ #1</div>
                        <small class="text-white-50">Chạm để mở lộc</small>
                    </div>
                    <div class="z-2 small text-warning fw-semibold">
                        <i class="bi bi-flower1 me-1"></i>Tết Khoẻ Re<i class="bi bi-flower1 ms-1"></i>
                    </div>
                </div>

                <div class="lixi-envelope" id="lixi-2" onclick="openLixi(2)">
                    <div class="lixi-seal">PHÚC</div>
                    <div class="z-2 text-center mt-2">
                        <div class="fw-bold text-warning fs-5">BAO LÌ XÌ #2</div>
                        <small class="text-white-50">Chạm để mở lộc</small>
                    </div>
                    <div class="z-2 small text-warning fw-semibold">
                        <i class="bi bi-flower1 me-1"></i>Tết Khoẻ Re<i class="bi bi-flower1 ms-1"></i>
                    </div>
                </div>
            </div>

            <div id="lixiResultBox" class="mx-auto mt-3 d-none" style="max-width: 560px;">
                <div class="p-4 rounded-4 shadow border border-2 border-danger bg-white">
                    <h4 id="lixiResultTitle" class="fw-bold mb-2"></h4>
                    <p id="lixiResultDesc" class="mb-3 text-dark"></p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a href="#dang-ky-tet" id="lixiClaimBtn" class="btn btn-danger rounded-pill px-4 fw-bold d-none">
                            Nhận mã bên dưới
                        </a>
                        <button type="button" class="btn btn-outline-warning text-dark fw-bold rounded-pill px-3" onclick="launchFireworksBurst(6)">
                            <i class="bi bi-stars me-1"></i>Bắn pháo hoa
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="resetLixi()">
                            <i class="bi bi-arrow-repeat me-1"></i>Bốc lại
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- ẢNH THIẾT KẾ GỐC + CÁC VÙNG NÚT BẤM HOẠT ĐỘNG THẬT        -->
    <!-- ========================================================= -->
    <div class="tet-poster-container">
        <img src="/images/tet-khoe-re-full.jpg"
             alt="Vinamilk Tết Khoẻ Re - Có Gì Đặc Sắc"
             class="tet-poster-img" />

        <!-- Nút 1: "Đăng kí ưu đãi >" trên Banner đỏ đầu trang -->
        <a href="#dang-ky-tet" class="poster-hotspot" title="Đăng kí ưu đãi"
           style="top: 8.1%; left: 39.5%; width: 35%; height: 2.1%;"></a>

        <!-- Nút 2: 8 hộp sữa "Mời bạn sắm sửa" -> Chuyển sang trang Sản phẩm -->
        <a asp-controller="Home" asp-action="Products" class="poster-hotspot" title="Xem danh mục sản phẩm Vinamilk"
           style="top: 32.5%; left: 2%; width: 96%; height: 6.2%; border-radius: 12px;"></a>

        <!-- Nút 3: "Đăng ký ngay" dưới thanh Tặng 5.000 điểm -->
        <a href="#dang-ky-tet" class="poster-hotspot" title="Đăng ký nhận 5.000 điểm"
           style="top: 40.3%; left: 58.5%; width: 16%; height: 1.4%;"></a>

        <!-- Nút 4: "Đăng ký ngay" trên Banner xanh Tích điểm đổi quà -->
        <a href="#dang-ky-tet" class="poster-hotspot" title="Đăng ký tích điểm đổi quà"
           style="top: 56.6%; left: 42.5%; width: 15%; height: 1.5%;"></a>

        <!-- Nút 5: "Đăng ký ngay" dưới mục Tận hưởng dễ dàng -->
        <a href="#dang-ky-tet" class="poster-hotspot" title="Đăng ký ngay"
           style="top: 70.6%; left: 58.5%; width: 16%; height: 1.4%;"></a>

        <!-- Nút 6: 3 thẻ Đổi điểm nhận ngay Voucher -->
        <a href="#dang-ky-tet" class="poster-hotspot" title="Đăng nhập / Đăng ký để đổi Voucher"
           style="top: 74.5%; left: 3%; width: 94%; height: 7.5%; border-radius: 12px;"></a>
    </div>

    <!-- ========================================================= -->
    <!-- SẢN PHẨM KHUYẾN MÃI ĐỘNG TỪ ADMIN                        -->
    <!-- ========================================================= -->
    <section id="san-pham-tet" class="py-5" style="background-color: #FFFFF1; border-top: 2px solid rgba(2, 19, 176, 0.12);">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="fw-bold display-6" style="color: #0213B0;">Sắm Sửa Đón Tết - Ưu Đãi Trực Tiếp</h2>
                <p class="text-muted">Các sản phẩm đang áp dụng giảm giá <strong>@discountPercent%</strong> từ chương trình khuyến mãi</p>
            </div>

            <div class="row g-4">
                @foreach (var p in Model)
                {
                    decimal finalPrice = (isCampaignActive && discountPercent > 0)
                        ? Math.Round(p.Price * (100 - discountPercent) / 100m, 0)
                        : p.Price;

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white">
                            <div class="position-relative text-center mb-3" style="height: 170px;">
                                @if (isCampaignActive && discountPercent > 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 rounded-pill px-2 py-1">
                                        -@discountPercent%
                                    </span>
                                }
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@p.Id">
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid h-100" style="object-fit: contain;" />
                                </a>
                            </div>

                            <div class="card-body p-0 d-flex flex-column">
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@p.Id" class="text-decoration-none fw-bold small mb-2" style="color: #0213B0; min-height: 38px;">
                                    @p.Name
                                </a>

                                <div class="mt-auto">
                                    @if (isCampaignActive && discountPercent > 0)
                                    {
                                        <div class="small text-muted text-decoration-line-through">@p.Price.ToString("N0")đ</div>
                                        <div class="fw-bold text-danger fs-5 mb-2">@finalPrice.ToString("N0")đ</div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-primary fs-5 mb-2">@p.Price.ToString("N0")đ</div>
                                    }

                                    <form asp-controller="Home" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-vnm w-100 py-2">
                                            Chọn mua
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- FORM ĐĂNG KÝ HOẠT ĐỘNG THẬT (CHUẨN GIAO DIỆN VINAMILK)    -->
    <!-- ========================================================= -->
    <section id="dang-ky-tet" class="vnm-reg-section">
        <div class="container" style="max-width: 780px;">
            <h2 class="fw-bold display-6 mb-1" style="color: #0213B0;">Đăng ký</h2>
            <p class="mb-4" style="color: #0213B0; font-size: 0.95rem;">
                Tạo tài khoản Vinamilk và tham gia chương trình khách hàng thân thiết
            </p>

            <!-- 4 ô quyền lợi xanh ngọc -->
            <div class="vnm-reg-benefits">
                <div class="vnm-benefit-item">
                    <i class="bi bi-calendar4-event"></i>
                    <span>Tham gia sự kiện &amp; hội thảo</span>
                </div>
                <div class="vnm-benefit-item">
                    <i class="bi bi-droplet"></i>
                    <span>Ưu đãi &amp; giảm giá</span>
                </div>
                <div class="vnm-benefit-item">
                    <i class="bi bi-life-preserver"></i>
                    <span>Lời khuyên từ chuyên gia</span>
                </div>
                <div class="vnm-benefit-item">
                    <i class="bi bi-geo-alt"></i>
                    <span>Theo dõi đơn hàng nhanh</span>
                </div>
            </div>

            @if (!isCampaignActive)
            {
                <div class="alert alert-warning text-center rounded-3">
                    <i class="bi bi-pause-circle-fill me-1"></i> Chiến dịch khuyến mãi hiện đang tạm dừng.
                </div>
            }
            else
            {
                <form asp-controller="Home" asp-action="SubmitLead" method="post" id="tetRegisterForm" onsubmit="return prepareFullNameBeforeSubmit()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fullName" id="combinedFullName" />

                    <!-- Ô 1: Số điện thoại -->
                    <div class="vnm-input-group">
                        <input type="tel" name="phoneNumber" class="vnm-underline-input" pattern="0[0-9]{9}" maxlength="10" placeholder="Số điện thoại *" required />
                    </div>

                    <!-- Ô 2: Email nhận thông báo & ưu đãi -->
                    <div class="vnm-input-group">
                        <input type="email" name="email" class="vnm-underline-input" placeholder="Email nhận thông báo & ưu đãi *" required />
                    </div>

                    <!-- Ô 3 & 4: Họ và tên đệm + Tên -->
                    <div class="row g-3">
                        <div class="col-md-7">
                            <div class="vnm-input-group">
                                <input type="text" id="lastNameInput" class="vnm-underline-input" placeholder="Họ và tên đệm *" required />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="vnm-input-group">
                                <input type="text" id="firstNameInput" class="vnm-underline-input" placeholder="Tên *" required />
                            </div>
                        </div>
                    </div>

                    <!-- Ô 5: Nhập mật khẩu (có nút ẩn/hiện) -->
                    <div class="vnm-input-group">
                        <input type="password" id="regPassword" class="vnm-underline-input" minlength="6" placeholder="Nhập mật khẩu *" required />
                        <button type="button" class="vnm-eye-btn" onclick="togglePwd('regPassword', this)" aria-label="Hiện/Ẩn mật khẩu">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>

                    <!-- Ô 6: Xác nhận mật khẩu (có nút ẩn/hiện) -->
                    <div class="vnm-input-group">
                        <input type="password" id="regConfirmPassword" class="vnm-underline-input" minlength="6" placeholder="Xác nhận mật khẩu *" required />
                        <button type="button" class="vnm-eye-btn" onclick="togglePwd('regConfirmPassword', this)" aria-label="Hiện/Ẩn xác nhận mật khẩu">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>

                    <!-- Hiển thị mã ưu đãi / lì xì đang được áp dụng -->
                    <div class="mb-3 px-3 py-2 rounded-3 d-flex justify-content-between align-items-center" style="background-color: #EBF0F7;">
                        <span class="small fw-semibold">Mã ưu đãi / Lộc Lì Xì nhận kèm:</span>
                        <span id="appliedVoucherText" class="fw-bold text-danger">@voucherCode (Giảm @discountPercent%)</span>
                    </div>

                    <div id="pwdErrorAlert" class="alert alert-danger py-2 small d-none">
                        Mật khẩu xác nhận không khớp! Vui lòng kiểm tra lại.
                    </div>

                    <button type="submit" class="btn-vnm-submit-reg">
                        Đăng ký ngay
                    </button>
                </form>
            }
        </div>
    </section>
</div>

<script>
    // Ẩn/hiện mật khẩu khi bấm icon con mắt
    function togglePwd(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye-slash';
        }
    }

    // Ghép Họ và tên đệm + Tên thành fullName và kiểm tra khớp mật khẩu
    function prepareFullNameBeforeSubmit() {
        const pwd = document.getElementById('regPassword').value;
        const confirmPwd = document.getElementById('regConfirmPassword').value;
        const errBox = document.getElementById('pwdErrorAlert');

        if (pwd !== confirmPwd) {
            errBox.classList.remove('d-none');
            return false;
        }
        errBox.classList.add('d-none');

        const hoDem = document.getElementById('lastNameInput').value.trim();
        const ten = document.getElementById('firstNameInput').value.trim();
        document.getElementById('combinedFullName').value = `${hoDem} ${ten}`.trim();
        return true;
    }

    // =========================================================
    // LOGIC BỐC 2 BAO LÌ XÌ (0Đ - 100K)
    // =========================================================
    let hasPickedLixi = false;

    function openLixi(pickedIndex) {
        if (hasPickedLixi) return;
        hasPickedLixi = true;

        const prizes = [0, 50000, 60000, 70000, 80000, 90000, 100000];
        const randomPrize = prizes[Math.floor(Math.random() * prizes.length)];

        const pickedCard = document.getElementById('lixi-' + pickedIndex);
        const otherCard = document.getElementById('lixi-' + (pickedIndex === 1 ? 2 : 1));

        pickedCard.classList.add('opened');
        otherCard.classList.add('disabled');

        const resultBox = document.getElementById('lixiResultBox');
        const resultTitle = document.getElementById('lixiResultTitle');
        const resultDesc = document.getElementById('lixiResultDesc');
        const claimBtn = document.getElementById('lixiClaimBtn');
        const voucherText = document.getElementById('appliedVoucherText');

        resultBox.classList.remove('d-none');
        launchFireworksBurst(randomPrize === 0 ? 4 : 10);

        if (randomPrize === 0) {
            pickedCard.innerHTML = `
                <div class="lixi-seal" style="background:#eee; color:#666;">0đ</div>
                <div class="z-2 text-center mt-2">
                    <div class="fw-bold text-secondary fs-5">0đ</div>
                    <div class="fw-bold text-danger small mt-1">Chúc bạn may mắn lần sau!</div>
                </div>
                <div class="z-2 small text-muted">Tết Khoẻ Re</div>
            `;
            resultTitle.className = 'fw-bold mb-2 text-secondary';
            resultTitle.innerHTML = '0đ - Chúc bạn may mắn lần sau!';
            resultDesc.innerText = 'Bao lì xì này chưa có tiền thưởng, bạn vẫn có thể đăng ký nhận mã ưu đãi mặc định bên dưới hoặc bấm Bốc lại nhé!';
            claimBtn.classList.add('d-none');
        } else {
            const formattedMoney = randomPrize.toLocaleString('vi-VN') + 'đ';
            const lixiCode = 'LIXI' + (randomPrize / 1000) + 'K';

            pickedCard.innerHTML = `
                <div class="lixi-seal">LỘC</div>
                <div class="z-2 text-center mt-2">
                    <div class="fw-bold text-danger fs-3">${formattedMoney}</div>
                    <span class="badge bg-danger mt-1">Mã: ${lixiCode}</span>
                </div>
                <div class="z-2 small fw-bold text-dark">Chúc Mừng Năm Mới!</div>
            `;
            resultTitle.className = 'fw-bold mb-2 text-danger';
            resultTitle.innerHTML = `🎉 Chúc mừng! Bạn bốc trúng lì xì ${formattedMoney}`;
            resultDesc.innerHTML = `Mã lì xì <strong>${lixiCode}</strong> trị giá <strong>${formattedMoney}</strong> đã được áp dụng cho tài khoản đăng ký bên dưới.`;
            claimBtn.classList.remove('d-none');

            if (voucherText) {
                voucherText.innerText = `${lixiCode} - Lì xì ${formattedMoney}`;
            }
        }
    }

    function resetLixi() {
        hasPickedLixi = false;
        document.getElementById('lixiResultBox').classList.add('d-none');

        const card1 = document.getElementById('lixi-1');
        const card2 = document.getElementById('lixi-2');

        card1.className = 'lixi-envelope';
        card2.className = 'lixi-envelope';

        card1.innerHTML = `
            <div class="lixi-seal">LỘC</div>
            <div class="z-2 text-center mt-2">
                <div class="fw-bold text-warning fs-5">BAO LÌ XÌ #1</div>
                <small class="text-white-50">Chạm để mở lộc</small>
            </div>
            <div class="z-2 small text-warning fw-semibold">
                <i class="bi bi-flower1 me-1"></i>Tết Khoẻ Re<i class="bi bi-flower1 ms-1"></i>
            </div>
        `;

        card2.innerHTML = `
            <div class="lixi-seal">PHÚC</div>
            <div class="z-2 text-center mt-2">
                <div class="fw-bold text-warning fs-5">BAO LÌ XÌ #2</div>
                <small class="text-white-50">Chạm để mở lộc</small>
            </div>
            <div class="z-2 small text-warning fw-semibold">
                <i class="bi bi-flower1 me-1"></i>Tết Khoẻ Re<i class="bi bi-flower1 ms-1"></i>
            </div>
        `;
    }

    // =========================================================
    // HIỆU ỨNG HOA MAI VÀNG 5 CÁNH RƠI KHẮP MÀN HÌNH
    // =========================================================
    (function initHoaMai() {
        const canvas = document.getElementById('mai-canvas');
        const ctx = canvas.getContext('2d');
        let w = canvas.width = window.innerWidth;
        let h = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            w = canvas.width = window.innerWidth;
            h = canvas.height = window.innerHeight;
        });

        const petals = Array.from({ length: 34 }, () => ({
            x: Math.random() * w,
            y: Math.random() * h,
            size: 7 + Math.random() * 7,
            speedY: 0.9 + Math.random() * 1.4,
            speedX: -0.6 + Math.random() * 1.2,
            angle: Math.random() * Math.PI * 2,
            spin: (Math.random() - 0.5) * 0.04
        }));

        function drawMaiFlower(x, y, r, angle) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle);
            ctx.fillStyle = '#FFD700';
            for (let i = 0; i < 5; i++) {
                ctx.rotate((Math.PI * 2) / 5);
                ctx.beginPath();
                ctx.ellipse(0, -r * 0.65, r * 0.42, r * 0.65, 0, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.fillStyle = '#E31837';
            ctx.beginPath();
            ctx.arc(0, 0, r * 0.25, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        function animateMai() {
            ctx.clearRect(0, 0, w, h);
            for (const p of petals) {
                p.y += p.speedY;
                p.x += p.speedX + Math.sin(p.angle) * 0.4;
                p.angle += p.spin;

                if (p.y > h + 20) {
                    p.y = -20;
                    p.x = Math.random() * w;
                }
                if (p.x > w + 20) p.x = -20;
                if (p.x < -20) p.x = w + 20;

                drawMaiFlower(p.x, p.y, p.size, p.angle);
            }
            requestAnimationFrame(animateMai);
        }
        animateMai();
    })();

    // =========================================================
    // HIỆU ỨNG PHÁO HOA RỰC RỠ KHI KHÁCH BỐC LÌ XÌ
    // =========================================================
    const fwCanvas = document.getElementById('fireworks-canvas');
    const fwCtx = fwCanvas.getContext('2d');
    let fwW = fwCanvas.width = window.innerWidth;
    let fwH = fwCanvas.height = window.innerHeight;
    let particles = [];

    window.addEventListener('resize', () => {
        fwW = fwCanvas.width = window.innerWidth;
        fwH = fwCanvas.height = window.innerHeight;
    });

    function createFirework(x, y) {
        const colors = ['#FFD700', '#FF1E42', '#00E5FF', '#FF9100', '#76FF03', '#FFFFFF'];
        const count = 65;
        for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.2;
            const speed = 2 + Math.random() * 5.5;
            particles.push({
                x, y,
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                alpha: 1,
                decay: 0.013 + Math.random() * 0.012,
                color: colors[Math.floor(Math.random() * colors.length)],
                size: 2.5 + Math.random() * 2.5
            });
        }
    }

    function launchFireworksBurst(burstCount = 8) {
        for (let i = 0; i < burstCount; i++) {
            setTimeout(() => {
                const x = fwW * (0.15 + Math.random() * 0.7);
                const y = fwH * (0.15 + Math.random() * 0.45);
                createFirework(x, y);
            }, i * 320);
        }
    }

    function animateFireworks() {
        fwCtx.clearRect(0, 0, fwW, fwH);
        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.06;
            p.vx *= 0.98;
            p.alpha -= p.decay;

            if (p.alpha <= 0) {
                particles.splice(i, 1);
                continue;
            }

            fwCtx.save();
            fwCtx.globalAlpha = p.alpha;
            fwCtx.fillStyle = p.color;
            fwCtx.beginPath();
            fwCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            fwCtx.fill();
            fwCtx.restore();
        }
        requestAnimationFrame(animateFireworks);
    }
    animateFireworks();
</script>