@model List<Vinamilk.Models.Entities.Product>
@{
    ViewData["Title"] = "Ưu đãi Vinamilk";
}

<div class="container py-4" style="max-width: 1100px;">
    <!-- BANNER XANH THEO ĐÚNG NGUYÊN BẢN CŨ -->
    <div class="card border-0 shadow rounded-4 overflow-hidden mb-5 text-white" style="background-color: #004b91;">
        <div class="row g-0 align-items-center">
            <div class="col-md-7 p-4 p-md-5">
                <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1 mb-3">CHƯƠNG TRÌNH ĐẶC BIỆT</span>
                <h2 class="fw-bold mb-3">Tặng Ngay Voucher Giảm 30%</h2>
                <p class="text-white text-opacity-90 mb-4 small" style="line-height: 1.7;">
                    Khám phá nguồn dinh dưỡng thuần khiết chuẩn quốc tế từ hệ thống trang trại sinh thái Vinamilk Green Farm. Đăng ký nhận mã ưu đãi áp dụng cho sản phẩm ưu đãi!
                </p>

                <!-- KHUNG FORM ĐĂNG KÝ CŨ -->
                <form asp-action="SubmitLead" method="post" class="bg-white p-3 rounded-4 shadow text-dark" style="max-width: 480px;">
                    @Html.AntiForgeryToken()
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <input type="text" name="fullName" class="form-control form-control-sm rounded-3" placeholder="Họ và tên..." required />
                        </div>
                        <div class="col-6">
                            <input type="email" name="email" class="form-control form-control-sm rounded-3" placeholder="Địa chỉ Email..." required />
                        </div>
                    </div>
                    <div class="input-group">
                        <input type="tel" name="phoneNumber" class="form-control form-control-sm rounded-start-3" placeholder="Số điện thoại..." maxlength="10" required />
                        <button type="submit" class="btn btn-sm rounded-end-3 px-3 fw-bold text-white" style="background-color: #00139e;">
                            Gửi đăng ký
                        </button>
                    </div>
                </form>
            </div>

            <div class="col-md-5 text-center p-3">
                <div class="bg-white p-3 rounded-4 shadow-sm mx-auto d-inline-block" style="width: 88%;">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="background-color: #00139e; height: 180px;">
                        <div class="text-white text-center">
                            <h2 class="fw-black mb-0" style="letter-spacing: 1px;">Vinamilk</h2>
                            <span class="small" style="font-size: 11px; opacity: 0.85;">EST. 1976</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold" style="font-size: 11px;">
                            Dinh dưỡng chuẩn quốc tế
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 py-3 mb-4 text-center fw-semibold" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 py-3 mb-4 text-center fw-semibold" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- DANH SÁCH SẢN PHẨM TIÊU BIỂU -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-box-seam text-primary me-2"></i>Danh sách sản phẩm tiêu biểu
        </h5>
        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1">
            Giảm 30%
        </span>
    </div>

    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                decimal currentPrice = item.Price * 0.7m;
                <div class="col-6 col-md-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 bg-white text-center p-3 d-flex flex-column justify-content-between position-relative">
                        <span class="position-absolute top-0 start-0 m-2 badge bg-danger rounded-pill" style="font-size: 10px;">
                            -30%
                        </span>

                        <div>
                            <a asp-action="ProductDetail" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl" alt="@item.Name" class="card-img-top mx-auto rounded-3" style="height: 140px; object-fit: contain;" />
                            </a>
                            <h6 class="card-title fw-bold text-dark small text-truncate mt-3 mb-1" title="@item.Name">
                                <a asp-action="ProductDetail" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Name</a>
                            </h6>

                            <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                                <span class="fw-bold text-primary">@currentPrice.ToString("N0")đ</span>
                                <span class="text-muted text-decoration-line-through small" style="font-size: 11px;">@item.Price.ToString("N0")đ</span>
                            </div>
                        </div>

                        <form asp-action="BuyNow" method="post" class="m-0">
                            <input type="hidden" name="productId" value="@item.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm w-100 rounded-pill py-1 text-white fw-semibold" style="font-size: 12px; background-color: #00139e;">
                                Mua ngay
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>