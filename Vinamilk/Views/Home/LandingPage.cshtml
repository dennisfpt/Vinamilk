@model IEnumerable<Vinamilk.Models.Entities.Product>
@{
    ViewData["Title"] = "Tết Khoẻ Re - Vinamilk Khuyến Mãi";
    bool isCampaignActive = ViewBag.IsCampaignActive is bool active && active;
    int discountPercent = ViewBag.DiscountPercent != null ? (int)ViewBag.DiscountPercent : 30;
    string voucherCode = ViewBag.VoucherCode as string ?? "TETKHOERE";
}

<style>
    html {
        scroll-behavior: smooth;
    }

    .tet-exact-wrapper {
        position: relative;
        width: 100%;
        background-color: #FFFFF1;
        overflow-x: hidden;
    }

    /* KHUNG CHỨA ẢNH THIẾT KẾ GỐC TỪ ĐẦU ĐẾN CUỐI */
    .tet-canvas-stage {
        position: relative;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        background-color: #FFFFF1;
        overflow: hidden;
    }

    /* Cắt 9.2% ở đáy ảnh vì _Layout.cshtml đã có Footer chuẩn Vinamilk */
    .tet-full-art {
        width: 100%;
        height: auto;
        display: block;
        margin-bottom: -9.2%;
        user-select: none;
    }

    /* CÁC VÙNG NÚT BẤM TƯƠNG TÁC ĐÈ KHỚP LÊN ẢNH GỐC */
    .art-btn-hotspot {
        position: absolute;
        display: block;
        z-index: 10;
        cursor: pointer;
        border-radius: 999px;
        transition: box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .art-btn-hotspot:hover {
        background-color: rgba(255, 215, 0, 0.22);
        box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.85);
    }

    /* FORM ĐĂNG KÝ THẬT ĐÈ KHỚP LÊN VÙNG FORM Ở CUỐI ẢNH */
    .art-form-overlay {
        position: absolute;
        left: 20.5%;
        width: 59%;
        top: 81.3%;
        z-index: 15;
        background-color: #FFFFF1;
        padding: 8px 6px 14px;
    }

    @@media (max-width: 768px) {
        .art-form-overlay {
            left: 8%;
            width: 84%;
            top: 81.1%;
        }
    }

    .vnm-real-field {
        position: relative;
        margin-bottom: 11px;
    }

    .vnm-real-input {
        width: 100%;
        background-color: #EBF0F7;
        border: none;
        border-bottom: 2px solid #0213B0;
        border-radius: 4px 4px 0 0;
        padding: 11px 40px 11px 14px;
        font-size: clamp(12px, 1.05vw, 15px);
        color: #0213B0;
        font-weight: 500;
        outline: none;
    }

    .vnm-real-input::placeholder {
        color: rgba(2, 19, 176, 0.75);
    }

    .vnm-real-input:focus {
        background-color: #DFE7F3;
    }

    .vnm-real-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #0213B0;
        font-size: 1rem;
        cursor: pointer;
    }

    .btn-vnm-real-submit {
        background-color: #0213B0;
        color: #ffffff;
        font-weight: 700;
        font-size: clamp(13px, 1.1vw, 16px);
        padding: 11px 24px;
        border: none;
        border-radius: 6px;
        width: 100%;
        transition: background-color 0.2s ease;
    }

    .btn-vnm-real-submit:hover {
        background-color: #000d80;
    }

    /* KHỐI 3 BAO LÌ XÌ PHÚC - LỘC - THỌ */
    .lixi-bar-section {
        background: linear-gradient(180deg, #FFF3D6 0%, #FFFFF1 100%);
        border-top: 3px solid #FFD700;
        border-bottom: 3px dashed #D9232E;
        padding: 36px 16px;
        max-width: 1280px;
        margin: 0 auto;
    }

    .lixi-envelope {
        width: 195px;
        height: 270px;
        background: linear-gradient(160deg, #E31837 0%, #9E0B22 100%);
        border: 3px solid #FFD700;
        border-radius: 16px;
        position: relative;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(168, 9, 34, 0.28);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 18px 12px;
        user-select: none;
        overflow: hidden;
    }

    .lixi-envelope::before {
        content: "";
        position: absolute;
        top: -42px;
        left: -10%;
        width: 120%;
        height: 102px;
        background: #B80B26;
        border-bottom: 3px solid #FFD700;
        border-radius: 50%;
    }

    .lixi-envelope:hover:not(.opened):not(.locked) {
        transform: translateY(-8px) rotate(-2deg);
    }

    .lixi-seal {
        width: 62px;
        height: 62px;
        background: radial-gradient(circle, #FFF066 0%, #FFB800 100%);
        border: 3px solid #FFF8DC;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        color: #8B0000;
        font-size: 1.2rem;
        z-index: 2;
        margin-top: 22px;
    }

    .lixi-envelope.locked {
        opacity: 0.45;
        cursor: not-allowed;
        filter: grayscale(0.45);
        pointer-events: none;
    }

    .lixi-envelope.opened {
        background: linear-gradient(180deg, #FFFDF0 0%, #FFEFA8 100%);
        border-color: #D9232E;
        color: #8B0000;
        transform: scale(1.04);
        cursor: default;
    }

    .lixi-envelope.opened::before {
        background: #E31837;
    }

    /* HOA MAI RƠI, PHÁO HOA & ĐÀN BÒ CHẠY */
    #mai-canvas, #fireworks-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
    }
    #mai-canvas { z-index: 9990; }
    #fireworks-canvas { z-index: 9999; }

    .cow-parade-track {
        position: fixed;
        bottom: 10px;
        left: 0;
        width: 100%;
        height: 60px;
        pointer-events: none;
        z-index: 9985;
        overflow: hidden;
    }

    .running-cow {
        position: absolute;
        bottom: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 2.2rem;
        animation: cowRunLeftToRight 17s linear infinite, cowBounce 0.45s ease-in-out infinite alternate;
    }

    .cow-flip {
        display: inline-block;
        transform: scaleX(-1);
    }

    .running-cow.cow-2 {
        animation-duration: 22s, 0.5s;
        animation-delay: -8s, 0s;
        font-size: 1.95rem;
    }

    .running-cow.cow-3 {
        animation-name: cowRunRightToLeft, cowBounce;
        animation-duration: 19s, 0.42s;
        animation-delay: -4s, 0s;
    }

    .cow-milk-badge {
        background: #0213B0;
        color: #FFD700;
        font-size: 11px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 12px;
        border: 1.5px solid #FFD700;
        white-space: nowrap;
    }

    @@keyframes cowRunLeftToRight {
        0%   { left: -220px; }
        100% { left: calc(100vw + 220px); }
    }

    @@keyframes cowRunRightToLeft {
        0%   { left: calc(100vw + 220px); }
        100% { left: -220px; }
    }

    @@keyframes cowBounce {
        from { margin-bottom: 0px; }
        to   { margin-bottom: 8px; }
    }
</style>

<canvas id="mai-canvas"></canvas>
<canvas id="fireworks-canvas"></canvas>

<!-- Đàn bò sữa chạy tung tăng -->
<div class="cow-parade-track" aria-hidden="true">
    <div class="running-cow cow-1">
        <span class="cow-milk-badge">Tết Khoẻ Re!</span><span class="cow-flip">🐄</span>
    </div>
    <div class="running-cow cow-2">
        <span class="cow-milk-badge">Vinamilk 100%</span><span class="cow-flip">🐮</span>
    </div>
    <div class="running-cow cow-3">
        <span>🐄</span><span class="cow-milk-badge">Phúc Lộc Thọ!</span>
    </div>
</div>

<div class="tet-exact-wrapper">
    <!-- Thông báo kết quả đăng ký -->
    <div class="container pt-2">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-4 shadow-sm mb-2 fw-semibold">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger rounded-4 shadow-sm mb-2 fw-semibold">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            </div>
        }
    </div>

    <!-- ========================================================= -->
    <!-- 3 BAO LÌ XÌ PHÚC - LỘC - THỌ (RANDOM 0Đ - 100K, 1 LƯỢT)   -->
    <!-- ========================================================= -->
    <section id="boc-li-xi" class="lixi-bar-section text-center">
        <span class="badge bg-danger rounded-pill px-3 py-2 mb-2">
            <i class="bi bi-fire me-1"></i> LỘC XUÂN VINAMILK TẾT KHOẺ RE
        </span>
        <h3 class="fw-bold mb-1" style="color: #B80B26;">Bốc Bao Lì Xì Phúc - Lộc - Thọ</h3>
        <p class="text-muted small mb-3">
            Chọn <strong>duy nhất 1 trong 3 bao lì xì</strong> bên dưới để nhận ngẫu nhiên từ <strong>0đ đến 100.000đ</strong> (mỗi khách chỉ được bốc 1 bao và nhận 1 mã).
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-4 my-2">
            <div class="lixi-envelope" id="lixi-1" onclick="openLixi(1, 'PHÚC')">
                <div class="lixi-seal">PHÚC</div>
                <div class="z-2 text-center mt-2">
                    <div class="fw-bold text-warning fs-6">BAO LÌ XÌ PHÚC</div>
                    <small class="text-white-50">Chạm để mở lộc</small>
                </div>
                <div class="z-2 small text-warning fw-semibold">Tết Khoẻ Re</div>
            </div>

            <div class="lixi-envelope" id="lixi-2" onclick="openLixi(2, 'LỘC')">
                <div class="lixi-seal">LỘC</div>
                <div class="z-2 text-center mt-2">
                    <div class="fw-bold text-warning fs-6">BAO LÌ XÌ LỘC</div>
                    <small class="text-white-50">Chạm để mở lộc</small>
                </div>
                <div class="z-2 small text-warning fw-semibold">Tết Khoẻ Re</div>
            </div>

            <div class="lixi-envelope" id="lixi-3" onclick="openLixi(3, 'THỌ')">
                <div class="lixi-seal">THỌ</div>
                <div class="z-2 text-center mt-2">
                    <div class="fw-bold text-warning fs-6">BAO LÌ XÌ THỌ</div>
                    <small class="text-white-50">Chạm để mở lộc</small>
                </div>
                <div class="z-2 small text-warning fw-semibold">Tết Khoẻ Re</div>
            </div>
        </div>

        <div id="lixiResultBox" class="mx-auto mt-3 d-none" style="max-width: 540px;">
            <div class="p-3 rounded-4 shadow-sm border border-2 border-danger bg-white">
                <h5 id="lixiResultTitle" class="fw-bold mb-1"></h5>
                <p id="lixiResultDesc" class="small mb-2 text-dark"></p>
                <a href="#vung-dang-ky" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold">
                    Điền thông tin nhận mã bên dưới
                </a>
            </div>
        </div>
    </section>

    <!-- ========================================================= -->
    <!-- TOÀN BỘ GIAO DIỆN THIẾT KẾ GỐC TỪ ĐẦU ĐẾN CUỐI + NÚT THẬT -->
    <!-- ========================================================= -->
    <div class="tet-canvas-stage">
        <img src="/images/tet-khoe-re-full.jpg"
             alt="Vinamilk Tết Khoẻ Re - Có Gì Đặc Sắc"
             class="tet-full-art" />

        <!-- 1. Nút "Đăng kí ưu đãi >" trên Banner đỏ đầu trang -->
        <a href="#vung-dang-ky" class="art-btn-hotspot" title="Đăng kí ưu đãi"
           style="top: 8.8%; left: 39.5%; width: 35%; height: 2.2%;"></a>

        <!-- 2. Khối 8 hộp sữa "Mời bạn sắm sửa" -> Bấm vào sang trang Sản phẩm -->
        <a asp-controller="Home" asp-action="Products" class="art-btn-hotspot" title="Xem và mua các dòng sữa Vinamilk"
           style="top: 35.2%; left: 1.5%; width: 97%; height: 6.8%; border-radius: 12px;"></a>

        <!-- 3. Nút "Đăng ký ngay" dưới thanh Tặng 5.000 điểm -->
        <a href="#vung-dang-ky" class="art-btn-hotspot" title="Đăng ký nhận 5.000 điểm"
           style="top: 43.8%; left: 58.8%; width: 15.8%; height: 1.5%;"></a>

        <!-- 4. Nút "Đăng ký ngay" trên Banner xanh Tích điểm đổi quà -->
        <a href="#vung-dang-ky" class="art-btn-hotspot" title="Đăng ký Vinamilk Rewards"
           style="top: 61.5%; left: 42.5%; width: 15%; height: 1.6%;"></a>

        <!-- 5. Nút "Đăng ký ngay" dưới mục Tận hưởng dễ dàng -->
        <a href="#vung-dang-ky" class="art-btn-hotspot" title="Đăng ký ngay"
           style="top: 76.8%; left: 58.8%; width: 15.8%; height: 1.5%;"></a>

        <!-- 6. 3 nút "Đăng nhập" trên 3 thẻ Đổi điểm nhận ngay Voucher -->
        <a asp-controller="Account" asp-action="Login" class="art-btn-hotspot" title="Đăng nhập đổi Voucher 50.000đ"
           style="top: 87.3%; left: 22.8%; width: 9.2%; height: 1.5%; border-radius: 6px;"></a>
        <a asp-controller="Account" asp-action="Login" class="art-btn-hotspot" title="Đăng nhập đổi Voucher Kombucha 35.000đ"
           style="top: 87.3%; left: 54.8%; width: 9.2%; height: 1.5%; border-radius: 6px;"></a>
        <a asp-controller="Account" asp-action="Login" class="art-btn-hotspot" title="Đăng nhập đổi Voucher 25.000đ"
           style="top: 87.3%; left: 86.8%; width: 9.2%; height: 1.5%; border-radius: 6px;"></a>

        <!-- 7. FORM ĐĂNG KÝ THẬT ĐÈ KHỚP LÊN ĐÚNG VÙNG FORM Ở CUỐI ẢNH -->
        <div id="vung-dang-ky" class="art-form-overlay">
            @if (!isCampaignActive)
            {
                <div class="alert alert-warning text-center rounded-3 mb-0">
                    Chiến dịch khuyến mãi hiện đang tạm dừng.
                </div>
            }
            else
            {
                <form asp-controller="Home" asp-action="SubmitLead" method="post" onsubmit="return submitTetForm()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fullName" id="combinedFullName" />

                    <div class="vnm-real-field">
                        <input type="tel" name="phoneNumber" class="vnm-real-input" pattern="0[0-9]{9}" maxlength="10" placeholder="Số điện thoại *" required />
                    </div>

                    <div class="vnm-real-field">
                        <input type="email" name="email" class="vnm-real-input" placeholder="Email nhận thông báo & ưu đãi *" required />
                    </div>

                    <div class="row g-2">
                        <div class="col-7">
                            <div class="vnm-real-field">
                                <input type="text" id="hoDemInput" class="vnm-real-input" placeholder="Họ và tên đệm *" required />
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="vnm-real-field">
                                <input type="text" id="tenInput" class="vnm-real-input" placeholder="Tên *" required />
                            </div>
                        </div>
                    </div>

                    <div class="vnm-real-field">
                        <input type="password" id="pwd1" class="vnm-real-input" minlength="6" placeholder="Nhập mật khẩu *" required />
                        <button type="button" class="vnm-real-eye" onclick="toggleEye('pwd1', this)">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>

                    <div class="vnm-real-field">
                        <input type="password" id="pwd2" class="vnm-real-input" minlength="6" placeholder="Xác nhận mật khẩu *" required />
                        <button type="button" class="vnm-real-eye" onclick="toggleEye('pwd2', this)">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center px-2 py-1 mb-2 rounded-2" style="background: #EBF0F7; font-size: 12px;">
                        <span class="fw-semibold" style="color: #0213B0;">Mã ưu đãi / Lộc Lì Xì áp dụng:</span>
                        <span id="appliedVoucherText" class="fw-bold text-danger">@voucherCode (Giảm @discountPercent%)</span>
                    </div>

                    <div id="pwdMismatchAlert" class="alert alert-danger py-1 px-2 small d-none mb-2">
                        Mật khẩu xác nhận không khớp!
                    </div>

                    <button type="submit" class="btn-vnm-real-submit">
                        Đăng ký ngay
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<script>
    function toggleEye(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye-slash';
        }
    }

    function submitTetForm() {
        const p1 = document.getElementById('pwd1').value;
        const p2 = document.getElementById('pwd2').value;
        const alertBox = document.getElementById('pwdMismatchAlert');
        if (p1 !== p2) {
            alertBox.classList.remove('d-none');
            return false;
        }
        alertBox.classList.add('d-none');

        const hoDem = document.getElementById('hoDemInput').value.trim();
        const ten = document.getElementById('tenInput').value.trim();
        document.getElementById('combinedFullName').value = `${hoDem} ${ten}`.trim();
        return true;
    }

    // =========================================================
    // 3 BAO LÌ XÌ PHÚC - LỘC - THỌ (RANDOM 0Đ - 100K, CHỈ 1 LẦN)
    // =========================================================
    const LIXI_STORAGE_KEY = 'VNM_TET_LIXI_PICKED_V1';

    function renderLixiResult(pickedIndex, label, prizeAmount, triggerFireworks) {
        for (let i = 1; i <= 3; i++) {
            const card = document.getElementById('lixi-' + i);
            if (!card) continue;

            if (i === pickedIndex) {
                card.classList.add('opened');
                card.classList.remove('locked');
                if (prizeAmount === 0) {
                    card.innerHTML = `
                        <div class="lixi-seal" style="background:#eee; color:#666;">0đ</div>
                        <div class="z-2 text-center mt-2">
                            <div class="fw-bold text-secondary fs-5">0đ</div>
                            <div class="fw-bold text-danger small mt-1">Chúc bạn may mắn lần sau!</div>
                        </div>
                        <div class="z-2 small text-muted">Bao ${label}</div>
                    `;
                } else {
                    const formattedMoney = prizeAmount.toLocaleString('vi-VN') + 'đ';
                    const lixiCode = 'LIXI' + (prizeAmount / 1000) + 'K';
                    card.innerHTML = `
                        <div class="lixi-seal">${label}</div>
                        <div class="z-2 text-center mt-2">
                            <div class="fw-bold text-danger fs-3">${formattedMoney}</div>
                            <span class="badge bg-danger mt-1">Mã: ${lixiCode}</span>
                        </div>
                        <div class="z-2 small fw-bold text-dark">Đã nhận lộc!</div>
                    `;
                }
            } else {
                card.classList.add('locked');
                const subText = card.querySelector('small');
                if (subText) subText.innerText = 'Đã khóa lượt bốc';
            }
        }

        const resultBox = document.getElementById('lixiResultBox');
        const resultTitle = document.getElementById('lixiResultTitle');
        const resultDesc = document.getElementById('lixiResultDesc');
        const voucherText = document.getElementById('appliedVoucherText');

        resultBox.classList.remove('d-none');

        if (triggerFireworks) {
            launchFireworksBurst(prizeAmount === 0 ? 4 : 10);
        }

        if (prizeAmount === 0) {
            resultTitle.className = 'fw-bold mb-1 text-secondary';
            resultTitle.innerHTML = `Bao ${label}: 0đ - Chúc bạn may mắn lần sau!`;
            resultDesc.innerText = 'Bạn đã sử dụng lượt bốc lì xì duy nhất. Hãy đăng ký bên dưới để nhận mã ưu đãi mặc định nhé!';
        } else {
            const formattedMoney = prizeAmount.toLocaleString('vi-VN') + 'đ';
            const lixiCode = 'LIXI' + (prizeAmount / 1000) + 'K';

            resultTitle.className = 'fw-bold mb-1 text-danger';
            resultTitle.innerHTML = `🎉 Chúc mừng! Bao ${label} tặng bạn ${formattedMoney}`;
            resultDesc.innerHTML = `Mã lì xì duy nhất của bạn là <strong>${lixiCode}</strong> (${formattedMoney}). Điền thông tin đăng ký bên dưới để nhận mã!`;

            if (voucherText) {
                voucherText.innerText = `${lixiCode} - Lì xì ${formattedMoney}`;
            }
        }
    }

    function openLixi(pickedIndex, label) {
        if (localStorage.getItem(LIXI_STORAGE_KEY)) {
            return;
        }

        const prizes = [0, 50000, 60000, 70000, 80000, 90000, 100000];
        const randomPrize = prizes[Math.floor(Math.random() * prizes.length)];

        localStorage.setItem(LIXI_STORAGE_KEY, JSON.stringify({
            pickedIndex: pickedIndex,
            label: label,
            prizeAmount: randomPrize
        }));

        renderLixiResult(pickedIndex, label, randomPrize, true);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const saved = localStorage.getItem(LIXI_STORAGE_KEY);
        if (saved) {
            try {
                const parsed = JSON.parse(saved);
                renderLixiResult(parsed.pickedIndex, parsed.label, parsed.prizeAmount, false);
            } catch {
                localStorage.removeItem(LIXI_STORAGE_KEY);
            }
        }
    });

    // =========================================================
    // HOA MAI VÀNG RƠI
    // =========================================================
    (function initHoaMai() {
        const canvas = document.getElementById('mai-canvas');
        const ctx = canvas.getContext('2d');
        let w = canvas.width = window.innerWidth;
        let h = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            w = canvas.width = window.innerWidth;
            h = canvas.height = window.innerHeight;
        });

        const petals = Array.from({ length: 30 }, () => ({
            x: Math.random() * w,
            y: Math.random() * h,
            size: 7 + Math.random() * 6,
            speedY: 0.8 + Math.random() * 1.3,
            speedX: -0.5 + Math.random() * 1.0,
            angle: Math.random() * Math.PI * 2,
            spin: (Math.random() - 0.5) * 0.04
        }));

        function drawMaiFlower(x, y, r, angle) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle);
            ctx.fillStyle = '#FFD700';
            for (let i = 0; i < 5; i++) {
                ctx.rotate((Math.PI * 2) / 5);
                ctx.beginPath();
                ctx.ellipse(0, -r * 0.65, r * 0.42, r * 0.65, 0, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.fillStyle = '#E31837';
            ctx.beginPath();
            ctx.arc(0, 0, r * 0.25, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        function animateMai() {
            ctx.clearRect(0, 0, w, h);
            for (const p of petals) {
                p.y += p.speedY;
                p.x += p.speedX + Math.sin(p.angle) * 0.4;
                p.angle += p.spin;

                if (p.y > h + 20) {
                    p.y = -20;
                    p.x = Math.random() * w;
                }
                if (p.x > w + 20) p.x = -20;
                if (p.x < -20) p.x = w + 20;

                drawMaiFlower(p.x, p.y, p.size, p.angle);
            }
            requestAnimationFrame(animateMai);
        }
        animateMai();
    })();

    // =========================================================
    // PHÁO HOA KHI BỐC LÌ XÌ
    // =========================================================
    const fwCanvas = document.getElementById('fireworks-canvas');
    const fwCtx = fwCanvas.getContext('2d');
    let fwW = fwCanvas.width = window.innerWidth;
    let fwH = fwCanvas.height = window.innerHeight;
    let particles = [];

    window.addEventListener('resize', () => {
        fwW = fwCanvas.width = window.innerWidth;
        fwH = fwCanvas.height = window.innerHeight;
    });

    function createFirework(x, y) {
        const colors = ['#FFD700', '#FF1E42', '#00E5FF', '#FF9100', '#76FF03', '#FFFFFF'];
        const count = 65;
        for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.2;
            const speed = 2 + Math.random() * 5.5;
            particles.push({
                x, y,
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                alpha: 1,
                decay: 0.013 + Math.random() * 0.012,
                color: colors[Math.floor(Math.random() * colors.length)],
                size: 2.5 + Math.random() * 2.5
            });
        }
    }

    function launchFireworksBurst(burstCount = 8) {
        for (let i = 0; i < burstCount; i++) {
            setTimeout(() => {
                const x = fwW * (0.15 + Math.random() * 0.7);
                const y = fwH * (0.15 + Math.random() * 0.45);
                createFirework(x, y);
            }, i * 320);
        }
    }

    function animateFireworks() {
        fwCtx.clearRect(0, 0, fwW, fwH);
        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.06;
            p.vx *= 0.98;
            p.alpha -= p.decay;

            if (p.alpha <= 0) {
                particles.splice(i, 1);
                continue;
            }

            fwCtx.save();
            fwCtx.globalAlpha = p.alpha;
            fwCtx.fillStyle = p.color;
            fwCtx.beginPath();
            fwCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            fwCtx.fill();
            fwCtx.restore();
        }
        requestAnimationFrame(animateFireworks);
    }
    animateFireworks();
</script>