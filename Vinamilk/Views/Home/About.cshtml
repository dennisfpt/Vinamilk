@{
    ViewData["Title"] = "Về chúng tôi - Vinamilk";
}

<div style="background-color: #FFFFF1; color: #0213B0;" class="py-5">
    <div class="container">
        <!-- Hero Giới thiệu -->
        <div class="text-center mx-auto mb-5" style="max-width: 780px;">
            <div class="fst-italic mb-2">Luôn là Vinamilk • Luôn cầu tiến</div>
            <h1 class="fw-bold display-4 mb-3">Cầu tiến là bí quyết</h1>
            <p class="lead" style="font-size: 1.1rem; opacity: 0.9;">
                Từ năm 1976, Vinamilk không ngừng tìm kiếm và ứng dụng công nghệ sản xuất tiên tiến nhất thế giới để đáp ứng những tiêu chuẩn dinh dưỡng khắt khe nhất cho mọi gia đình Việt.
            </p>
        </div>

        <!-- 3 Giá trị cốt lõi (Bố cục số 01 - 02 - 03 chuẩn Vinamilk) -->
        <div class="row g-4 py-4 border-top border-bottom" style="border-color: rgba(2, 19, 176, 0.2) !important;">
            <div class="col-md-4 px-lg-4" style="border-right: 1px solid rgba(2, 19, 176, 0.15);">
                <div class="small fw-bold mb-1">01</div>
                <h3 class="fw-bold fst-italic mb-3">Luôn vắt tươi ngon</h3>
                <p class="small mb-0">
                    Nguồn sữa tươi nguyên chất từ hệ thống <strong>14 trang trại sinh thái</strong> đạt chuẩn GlobalG.A.P trải dài khắp Việt Nam, đảm bảo đàn bò được chăm sóc trong điều kiện khí hậu mát mẻ và nguồn thức ăn hữu cơ.
                </p>
            </div>
            <div class="col-md-4 px-lg-4" style="border-right: 1px solid rgba(2, 19, 176, 0.15);">
                <div class="small fw-bold mb-1">02</div>
                <h3 class="fw-bold fst-italic mb-3">Luôn sạch tinh khiết</h3>
                <p class="small mb-0">
                    Hệ thống <strong>14 nhà máy công nghệ cao</strong> tự động hóa khép kín chuẩn quốc tế, giữ trọn vẹn dưỡng chất tự nhiên và hương vị thuần khiết trong từng giọt sữa.
                </p>
            </div>
            <div class="col-md-4 px-lg-4">
                <div class="small fw-bold mb-1">03</div>
                <h3 class="fw-bold fst-italic mb-3">Để tâm hành động Net Zero</h3>
                <p class="small mb-0">
                    Tiên phong phát triển bền vững với 3 đơn vị đầu tiên đạt Chứng nhận Quốc tế về Trung hòa Carbon (PAS 2060), hướng tới mục tiêu phát thải ròng bằng 0 vào năm 2050.
                </p>
            </div>
        </div>

        <!-- Số liệu ấn tượng -->
        <div class="row g-4 text-center mt-4 pt-3">
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold">1976</div>
                <div class="small fw-semibold">Hành trình vươn cao</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold">14+</div>
                <div class="small fw-semibold">Trang trại chuẩn quốc tế</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold">14+</div>
                <div class="small fw-semibold">Nhà máy hiện đại</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="display-5 fw-bold">60+</div>
                <div class="small fw-semibold">Quốc gia xuất khẩu</div>
            </div>
        </div>
    </div>
</div>