@{
    ViewData["Title"] = "Giới thiệu Vinamilk";
}

<div class="container py-4" style="max-width: 960px;">
    <!-- Banner Giới thiệu -->
    <div class="rounded-4 p-4 p-md-5 mb-4 text-white text-center position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, #004b91 0%, #0077c8 100%);">
        <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold mb-2 shadow-sm">Thương Hiệu Quốc Gia</span>
        <h2 class="fw-bold mb-2">Vinamilk - Vươn Cao Việt Nam</h2>
        <p class="mb-0 opacity-90 small">Hơn 48 năm đồng hành cùng dinh dưỡng và tầm vóc của hàng triệu gia đình Việt Nam.</p>
    </div>

    <!-- 3 Cột giá trị cốt lõi -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 55px; height: 55px;">
                    <i class="bi bi-award fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark">Chất Lượng Quốc Tế</h6>
                <p class="small text-muted mb-0">Hệ thống trang trại đạt chuẩn GlobalG.A.P và công nghệ chế biến hiện đại hàng đầu thế giới.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
                <div class="rounded-circle bg-success bg-opacity-10 text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 55px; height: 55px;">
                    <i class="bi bi-tree fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark">Phát Triển Bền Vững</h6>
                <p class="small text-muted mb-0">Tiên phong lộ trình Net Zero 2050, hướng đến trang trại sinh thái và bảo vệ môi trường xanh.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 55px; height: 55px;">
                    <i class="bi bi-heart fs-3"></i>
                </div>
                <h6 class="fw-bold text-dark">Vì Cộng Đồng</h6>
                <p class="small text-muted mb-0">Quỹ sữa Vươn cao Việt Nam đã trao hơn 42 triệu ly sữa cho trẻ em có hoàn cảnh khó khăn.</p>
            </div>
        </div>
    </div>

    <!-- Thông tin chi tiết lịch sử -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Hành trình phát triển</h5>
        <div class="row align-items-center g-4">
            <div class="col-md-6">
                <p class="small text-secondary mb-2" style="line-height: 1.8;">
                    Thành lập từ năm 1976, Công ty Cổ phần Sữa Việt Nam (Vinamilk) đã vươn lên trở thành một trong 40 công ty sữa lớn nhất thế giới về doanh thu. Vinamilk quản lý mạng lưới 14 trang trại chuẩn quốc tế cùng 15 nhà máy hiện đại trải dài khắp cả nước.
                </p>
                <p class="small text-secondary mb-0" style="line-height: 1.8;">
                    Với sứ mệnh "Để mọi trẻ em Việt Nam đều được uống sữa mỗi ngày", chúng tôi cam kết mang đến những nguồn dưỡng chất tự nhiên và an toàn nhất.
                </p>
            </div>
            <div class="col-md-6 text-center">
                <img src="/images/hero-banner.jpg" alt="Trang trại Vinamilk" class="img-fluid rounded-4 shadow-sm" style="max-height: 240px; object-fit: cover; width: 100%;" />
            </div>
        </div>
    </div>
</div>