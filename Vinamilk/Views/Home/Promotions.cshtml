@{
    ViewData["Title"] = "Trang khuyến mãi";
}

<div class="container py-4">
    <!-- HERO BANNER KHUYẾN MÃI (MÀN 8) -->
    <div class="rounded-4 p-4 p-md-5 mb-5 text-white position-relative overflow-hidden" 
         style="background: linear-gradient(90deg, #0077c8 0%, #00a0e9 100%);">
        <div class="row align-items-center">
            <div class="col-md-7">
                <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold mb-2">Vinamilk Promo</span>
                <h1 class="display-6 fw-bold mb-2">Ưu đãi đặc biệt<br />Tháng 10</h1>
                <p class="mb-4 opacity-90 small">Mua sữa Vinamilk nhận ngay nhiều ưu đãi hấp dẫn</p>
                <a asp-action="Products" class="btn btn-light text-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    Mua ngay &rarr;
                </a>
            </div>
            <div class="col-md-5 text-center position-relative mt-4 mt-md-0">
                <div class="position-absolute top-0 end-0 bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow" 
                     style="width: 65px; height: 65px; font-size: 15px; transform: rotate(15deg);">
                    -30%
                </div>
                <img src="https://images.unsplash.com/photo-1550583724-b2692b85b150?w=500" alt="Ưu đãi Vinamilk" class="img-fluid rounded-3 shadow" style="max-height: 220px; object-fit: cover;" />
            </div>
        </div>
    </div>

    <!-- 3 CHƯƠNG TRÌNH NỔI BẬT THEO MÀN 8 -->
    <h5 class="fw-bold text-dark mb-4">Chương trình nổi bật</h5>
    <div class="row g-4">
        <!-- Card 1: Giảm 20% sữa tươi -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex flex-row align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Giảm 20%</h6>
                    <small class="text-muted d-block mb-2">Sữa tươi các loại</small>
                    <a asp-action="Products" asp-route-categoryId="1" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size: 12px;">Xem ngay</a>
                </div>
            </div>
        </div>

        <!-- Card 2: Giảm 15% sữa chua -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex flex-row align-items-center gap-3">
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-percent"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Giảm 15%</h6>
                    <small class="text-muted d-block mb-2">Sữa chua ăn & uống</small>
                    <a asp-action="Products" asp-route-categoryId="3" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3" style="font-size: 12px;">Xem ngay</a>
                </div>
            </div>
        </div>

        <!-- Card 3: Quà tặng bình nước -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex flex-row align-items-center gap-3">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-gift-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Quà tặng</h6>
                    <small class="text-muted d-block mb-2">Bình nước thể thao</small>
                    <a asp-action="Products" class="btn btn-sm btn-outline-success rounded-pill px-3" style="font-size: 12px;">Chi tiết</a>
                </div>
            </div>
        </div>
    </div>
</div>