@{
    ViewData["Title"] = "Hệ thống cửa hàng Vinamilk";
}

<div style="background-color: #FFFFF1; color: #0213B0;" class="py-5">
    <div class="container">
        <div class="text-center mx-auto mb-4" style="max-width: 650px;">
            <h1 class="fw-bold display-5 mb-2">Hệ thống cửa hàng</h1>
            <p class="small opacity-85">Tìm cửa hàng Vinamilk (Giấc Mơ Sữa Việt) gần bạn nhất để trải nghiệm sản phẩm tươi ngon mỗi ngày</p>
        </div>

        <!-- Bộ lọc Khu vực & Tìm kiếm -->
        <div class="row g-3 justify-content-center mb-5">
            <div class="col-md-4">
                <select id="cityFilter" class="form-select" style="background-color: #EBF0F7; border: none; border-bottom: 1.5px solid #0213B0; color: #0213B0; padding: 12px;" onchange="filterStores()">
                    <option value="ALL">Tất cả Tỉnh / Thành phố</option>
                    <option value="HCM">TP. Hồ Chí Minh</option>
                    <option value="HN">Hà Nội</option>
                    <option value="DN">Đà Nẵng</option>
                    <option value="CT">Cần Thơ</option>
                </select>
            </div>
            <div class="col-md-5">
                <input type="text" id="storeKeyword" class="form-control" placeholder="Nhập tên đường, quận/huyện..." style="background-color: #EBF0F7; border: none; border-bottom: 1.5px solid #0213B0; color: #0213B0; padding: 12px;" onkeyup="filterStores()" />
            </div>
        </div>

        <!-- Danh sách cửa hàng -->
        <div class="row g-4" id="storeList">
            <div class="col-md-6 col-lg-4 store-card" data-city="HCM">
                <div class="p-4 rounded-3 h-100" style="background-color: #EBF0F7; border-left: 4px solid #0213B0;">
                    <span class="badge mb-2" style="background-color: #0213B0; color: #FFFFF1;">TP. Hồ Chí Minh</span>
                    <h5 class="fw-bold mb-2">Vinamilk Shop - Tân Trào (Trụ sở chính)</h5>
                    <p class="small mb-2"><i class="bi bi-geo-alt-fill me-1"></i> Số 10 Tân Trào, Phường Tân Mỹ, Quận 7, TP. HCM</p>
                    <p class="small mb-2"><i class="bi bi-clock me-1"></i> 07:30 – 21:30 (Tất cả các ngày)</p>
                    <p class="small fw-bold mb-0"><i class="bi bi-telephone-fill me-1"></i> 1900 636 979</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 store-card" data-city="HCM">
                <div class="p-4 rounded-3 h-100" style="background-color: #EBF0F7; border-left: 4px solid #0213B0;">
                    <span class="badge mb-2" style="background-color: #0213B0; color: #FFFFF1;">TP. Hồ Chí Minh</span>
                    <h5 class="fw-bold mb-2">Vinamilk Shop - Nguyễn Thị Minh Khai</h5>
                    <p class="small mb-2"><i class="bi bi-geo-alt-fill me-1"></i> 284 Nguyễn Thị Minh Khai, Phường 5, Quận 3, TP. HCM</p>
                    <p class="small mb-2"><i class="bi bi-clock me-1"></i> 07:30 – 21:30 (Tất cả các ngày)</p>
                    <p class="small fw-bold mb-0"><i class="bi bi-telephone-fill me-1"></i> 028 3929 1880</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 store-card" data-city="HN">
                <div class="p-4 rounded-3 h-100" style="background-color: #EBF0F7; border-left: 4px solid #0213B0;">
                    <span class="badge mb-2" style="background-color: #0213B0; color: #FFFFF1;">Hà Nội</span>
                    <h5 class="fw-bold mb-2">Vinamilk Shop - Bà Triệu</h5>
                    <p class="small mb-2"><i class="bi bi-geo-alt-fill me-1"></i> 112 Bà Triệu, Quận Hai Bà Trưng, Hà Nội</p>
                    <p class="small mb-2"><i class="bi bi-clock me-1"></i> 07:30 – 21:30 (Tất cả các ngày)</p>
                    <p class="small fw-bold mb-0"><i class="bi bi-telephone-fill me-1"></i> 024 3943 5678</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 store-card" data-city="DN">
                <div class="p-4 rounded-3 h-100" style="background-color: #EBF0F7; border-left: 4px solid #0213B0;">
                    <span class="badge mb-2" style="background-color: #0213B0; color: #FFFFF1;">Đà Nẵng</span>
                    <h5 class="fw-bold mb-2">Vinamilk Shop - Nguyễn Văn Linh</h5>
                    <p class="small mb-2"><i class="bi bi-geo-alt-fill me-1"></i> 156 Nguyễn Văn Linh, Quận Hải Châu, Đà Nẵng</p>
                    <p class="small mb-2"><i class="bi bi-clock me-1"></i> 07:30 – 21:30 (Tất cả các ngày)</p>
                    <p class="small fw-bold mb-0"><i class="bi bi-telephone-fill me-1"></i> 0236 365 2211</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 store-card" data-city="CT">
                <div class="p-4 rounded-3 h-100" style="background-color: #EBF0F7; border-left: 4px solid #0213B0;">
                    <span class="badge mb-2" style="background-color: #0213B0; color: #FFFFF1;">Cần Thơ</span>
                    <h5 class="fw-bold mb-2">Vinamilk Shop - Đại Lộ Hòa Bình</h5>
                    <p class="small mb-2"><i class="bi bi-geo-alt-fill me-1"></i> 42 Đại lộ Hòa Bình, Quận Ninh Kiều, Cần Thơ</p>
                    <p class="small mb-2"><i class="bi bi-clock me-1"></i> 07:30 – 21:30 (Tất cả các ngày)</p>
                    <p class="small fw-bold mb-0"><i class="bi bi-telephone-fill me-1"></i> 0292 381 4455</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function filterStores() {
        const city = document.getElementById('cityFilter').value;
        const kw = document.getElementById('storeKeyword').value.toLowerCase().trim();
        document.querySelectorAll('.store-card').forEach(card => {
            const matchCity = (city === 'ALL' || card.dataset.city === city);
            const matchKw = (kw === '' || card.innerText.toLowerCase().includes(kw));
            card.style.display = (matchCity && matchKw) ? '' : 'none';
        });
    }
</script>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tọa độ bao quát Việt Nam
            const defaultLat = 14.0583;
            const defaultLng = 108.2772;

            const map = L.map('map').setView([10.7769, 106.6953], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            setTimeout(() => { map.invalidateSize(); }, 300);

            const markers = {};
            const storeCards = document.querySelectorAll('.store-item');

            storeCards.forEach((card, index) => {
                const lat = parseFloat(card.getAttribute('data-lat'));
                const lng = parseFloat(card.getAttribute('data-lng'));
                const name = card.getAttribute('data-name');
                const addr = card.getAttribute('data-address');
                const phone = card.getAttribute('data-phone');

                if (!isNaN(lat) && !isNaN(lng)) {
                    const popup = `
                        <div style="font-size: 13px; line-height: 1.4;">
                            <b style="color: #004b91; font-size: 14px;">${name}</b><br/>
                            <span>📍 ${addr}</span><br/>
                            <span style="color: #28a745; font-weight: bold;">📞 ${phone}</span>
                        </div>
                    `;
                    const marker = L.marker([lat, lng]).addTo(map).bindPopup(popup);
                    markers[name] = marker;

                    if (index === 0) marker.openPopup();

                    card.addEventListener('click', function () {
                        storeCards.forEach(c => c.classList.remove('border-primary', 'bg-light'));
                        this.classList.add('border-primary', 'bg-light');
                        map.flyTo([lat, lng], 15, { duration: 1.2 });
                        marker.openPopup();
                    });
                }
            });

            // Lọc cửa hàng theo thành phố
            const cityFilter = document.getElementById('cityFilter');
            const countBadge = document.getElementById('storeCount');

            cityFilter.addEventListener('change', function () {
                const selected = this.value;
                let visibleCount = 0;
                let firstVisible = null;

                storeCards.forEach(card => {
                    const city = card.getAttribute('data-city');
                    if (selected === 'ALL' || city === selected) {
                        card.style.display = 'block';
                        visibleCount++;
                        if (!firstVisible) firstVisible = card;
                    } else {
                        card.style.display = 'none';
                    }
                });

                countBadge.innerText = `${visibleCount} điểm bán`;

                if (firstVisible) {
                    const lat = parseFloat(firstVisible.getAttribute('data-lat'));
                    const lng = parseFloat(firstVisible.getAttribute('data-lng'));
                    const name = firstVisible.getAttribute('data-name');
                    map.flyTo([lat, lng], selected === 'ALL' ? 6 : 13, { duration: 1 });
                    markers[name]?.openPopup();
                }
            });
        });
    </script>
}