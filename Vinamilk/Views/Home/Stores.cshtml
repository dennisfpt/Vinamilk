@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tọa độ bao quát Việt Nam
            const defaultLat = 14.0583;
            const defaultLng = 108.2772;

            const map = L.map('map').setView([10.7769, 106.6953], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            setTimeout(() => { map.invalidateSize(); }, 300);

            const markers = {};
            const storeCards = document.querySelectorAll('.store-item');

            storeCards.forEach((card, index) => {
                const lat = parseFloat(card.getAttribute('data-lat'));
                const lng = parseFloat(card.getAttribute('data-lng'));
                const name = card.getAttribute('data-name');
                const addr = card.getAttribute('data-address');
                const phone = card.getAttribute('data-phone');

                if (!isNaN(lat) && !isNaN(lng)) {
                    const popup = `
                        <div style="font-size: 13px; line-height: 1.4;">
                            <b style="color: #004b91; font-size: 14px;">${name}</b><br/>
                            <span>📍 ${addr}</span><br/>
                            <span style="color: #28a745; font-weight: bold;">📞 ${phone}</span>
                        </div>
                    `;
                    const marker = L.marker([lat, lng]).addTo(map).bindPopup(popup);
                    markers[name] = marker;

                    if (index === 0) marker.openPopup();

                    card.addEventListener('click', function () {
                        storeCards.forEach(c => c.classList.remove('border-primary', 'bg-light'));
                        this.classList.add('border-primary', 'bg-light');
                        map.flyTo([lat, lng], 15, { duration: 1.2 });
                        marker.openPopup();
                    });
                }
            });

            // Lọc cửa hàng theo thành phố
            const cityFilter = document.getElementById('cityFilter');
            const countBadge = document.getElementById('storeCount');

            cityFilter.addEventListener('change', function () {
                const selected = this.value;
                let visibleCount = 0;
                let firstVisible = null;

                storeCards.forEach(card => {
                    const city = card.getAttribute('data-city');
                    if (selected === 'ALL' || city === selected) {
                        card.style.display = 'block';
                        visibleCount++;
                        if (!firstVisible) firstVisible = card;
                    } else {
                        card.style.display = 'none';
                    }
                });

                countBadge.innerText = `${visibleCount} điểm bán`;

                if (firstVisible) {
                    const lat = parseFloat(firstVisible.getAttribute('data-lat'));
                    const lng = parseFloat(firstVisible.getAttribute('data-lng'));
                    const name = firstVisible.getAttribute('data-name');
                    map.flyTo([lat, lng], selected === 'ALL' ? 6 : 13, { duration: 1 });
                    markers[name]?.openPopup();
                }
            });
        });
    </script>
}