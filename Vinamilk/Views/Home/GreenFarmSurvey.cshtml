@model Vinamilk.Models.Entities.GreenFarmSurvey
@{
    ViewData["Title"] = "Khảo sát Trải nghiệm Sữa tươi Green Farm";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold mb-2">
                        <i class="bi bi-flower1 me-1"></i> Vinamilk Green Farm
                    </span>
                    <h3 class="fw-bold" style="color: #004b91;">Khảo Sát Người Tiêu Dùng Green Farm</h3>
                    <p class="text-muted small">Ý kiến của Anh/Chị giúp chúng tôi nâng cao chất lượng sữa tươi sinh thái</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3 small py-3 mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="GreenFarmSurvey" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Họ và tên Anh/Chị *</label>
                            <input asp-for="FullName" class="form-control rounded-3 bg-light border-0 py-2" placeholder="Nguyễn Thị Lan" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Số điện thoại *</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3 bg-light border-0 py-2" placeholder="0901234567" maxlength="10" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">1. Độ tuổi hiện tại của Anh/Chị? *</label>
                            <select asp-for="AgeGroup" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="">-- Chọn độ tuổi --</option>
                                <option value="Dưới 18 tuổi">Dưới 18 tuổi</option>
                                <option value="18 – 24 tuổi">Từ 18 – 24 tuổi</option>
                                <option value="25 – 35 tuổi">Từ 25 – 35 tuổi</option>
                                <option value="Trên 35 tuổi">Trên 35 tuổi</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">2. Anh/Chị mua sữa cho ai dùng? *</label>
                            <select asp-for="TargetUser" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="">-- Chọn đối tượng --</option>
                                <option value="Bản thân">Cho bản thân sử dụng</option>
                                <option value="Con nhỏ">Cho con nhỏ / học sinh</option>
                                <option value="Bố mẹ">Cho bố mẹ / người lớn tuổi</option>
                                <option value="Cả gia đình">Cho cả gia đình cùng dùng</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">3. Dòng sữa Green Farm hay dùng? *</label>
                            <select asp-for="PreferredProduct" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="Green Farm Ít đường">Sữa tươi Green Farm Ít đường</option>
                                <option value="Green Farm Không đường">Sữa tươi Green Farm Không đường</option>
                                <option value="Green Farm Có đường">Sữa tươi Green Farm Có đường</option>
                                <option value="Green Farm Hương Dâu / Sôcôla">Green Farm Hương Dâu / Sôcôla</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">4. Tần suất sử dụng? *</label>
                            <select asp-for="Frequency" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="Hàng ngày">Uống đều đặn hàng ngày</option>
                                <option value="3 – 5 ngày/tuần">Từ 3 – 5 ngày/tuần</option>
                                <option value="Thỉnh thoảng">Thỉnh thoảng (1 – 2 lần/tuần)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">5. Yếu tố quyết định chọn Green Farm? *</label>
                            <select asp-for="ReasonToChoose" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="Nguồn gốc trang trại sinh thái">Nguồn gốc trang trại sinh thái</option>
                                <option value="Vị thanh nhẹ tự nhiên">Hương vị thanh nhẹ, tự nhiên</option>
                                <option value="Dinh dưỡng cao tự nhiên">Hàm lượng dinh dưỡng cao tự nhiên</option>
                                <option value="Bao bì thiết kế cao cấp">Bao bì thiết kế đẹp, cao cấp</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">6. Kênh mua sắm quen thuộc? *</label>
                            <select asp-for="Channel" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="Siêu thị / Cửa hàng tiện lợi">Chuỗi siêu thị / Cửa hàng tiện lợi</option>
                                <option value="Vinamilk Store">Cửa hàng Giấc Mơ Sữa Việt</option>
                                <option value="Website / Sàn TMĐT">Website chính hãng / Sàn TMĐT</option>
                                <option value="Ứng dụng giao nhanh">Ứng dụng giao nhanh (GrabMart...)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">7. Quy cách đóng gói ưa chuộng? *</label>
                            <select asp-for="Packaging" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="Hộp 180ml">Hộp nhỏ 180ml</option>
                                <option value="Hộp 110ml">Hộp nhỏ 110ml</option>
                                <option value="Hộp lớn 1 Lít">Hộp lớn 1 Lít</option>
                                <option value="Thùng nguyên 48 hộp">Thùng nguyên 48 hộp</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">8. Chi phí trung bình mỗi tháng? *</label>
                            <select asp-for="MonthlySpending" class="form-select rounded-3 bg-light border-0 py-2" required>
                                <option value="Dưới 300.000đ">Dưới 300.000 VNĐ</option>
                                <option value="300.000đ – 600.000đ">Từ 300.000 – 600.000 VNĐ</option>
                                <option value="600.000đ – 1.200.000đ">Từ 600.000 – 1.200.000 VNĐ</option>
                                <option value="Trên 1.200.000đ">Trên 1.200.000 VNĐ</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-muted">9. Góp ý cải thiện sản phẩm cho Vinamilk</label>
                        <textarea asp-for="Feedback" rows="3" class="form-control rounded-3 bg-light border-0" placeholder="Chia sẻ cảm nhận về hương vị, bao bì..."></textarea>
                    </div>

                    <button type="submit" class="btn text-white w-100 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #2e7d32;">
                        Gửi Khảo Sát Ngay
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>