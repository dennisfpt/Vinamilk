@model IEnumerable<Vinamilk.Models.Entities.Product>
@{
    ViewData["Title"] = "Trang sản phẩm Vinamilk";
    var categories = (ViewData["Categories"] as List<Vinamilk.Models.Entities.Category>) 
                     ?? (ViewBag.Categories as List<Vinamilk.Models.Entities.Category>) 
                     ?? new List<Vinamilk.Models.Entities.Category>();
}

<div class="container py-3 py-md-4">
    <div class="row g-3 g-md-4">
        <!-- CỘT TRÁI: DANH MỤC SẢN PHẨM (Tự co giãn trên điện thoại & iPad) -->
        <div class="col-12 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <h6 class="fw-bold text-dark mb-2 mb-md-3">Danh mục</h6>
                <div class="list-group list-group-flush small d-flex flex-row flex-lg-column overflow-auto py-1 gap-1">
                    <a asp-action="Products" class="list-group-item list-group-item-action border-0 px-2 rounded-2 text-nowrap @(ViewBag.CurrentCategory == null ? "fw-bold text-primary bg-light" : "text-secondary")">
                        Tất cả sản phẩm
                    </a>
                    @if (categories.Any())
                    {
                        foreach (var c in categories)
                        {
                            <a asp-action="Products" asp-route-categoryId="@c.Id" class="list-group-item list-group-item-action border-0 px-2 rounded-2 text-nowrap @(ViewBag.CurrentCategory == c.Id ? "fw-bold text-primary bg-light" : "text-secondary")">
                                @c.Name
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: LƯỚI SẢN PHẨM & TÌM KIẾM, SẮP XẾP -->
        <div class="col-12 col-lg-9">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 mb-md-4 gap-2">
                <h5 class="fw-bold text-dark mb-0">Sản phẩm</h5>
                <form asp-action="Products" method="get" class="d-flex gap-2 flex-grow-1 flex-md-grow-0 justify-content-end">
                    <input type="hidden" name="categoryId" value="@ViewBag.CurrentCategory" />
                    <input type="text" name="keyword" value="@ViewBag.CurrentKeyword" class="form-control form-control-sm rounded-pill px-3" placeholder="Tìm kiếm sản phẩm..." style="min-width: 150px; max-width: 220px;" />
                    <select name="sort" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill" style="width: 140px;">
                        <option value="">Sắp xếp: Mặc định</option>
                        <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Giá: Thấp &rarr; Cao</option>
                        <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Giá: Cao &rarr; Thấp</option>
                    </select>
                </form>
            </div>

            <!-- Lưới sản phẩm: 2 cột trên điện thoại (col-6), 3 cột trên iPad/Laptop (col-md-4) -->
            <div class="row g-2 g-md-3">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-6 col-md-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 bg-white text-center p-2 p-md-3 product-card d-flex flex-column justify-content-between">
                                <div>
                                    <a asp-action="ProductDetail" asp-route-id="@item.Id" class="d-block text-center">
                                        <img src="@item.ImageUrl" alt="@item.Name" class="card-img-top mx-auto rounded-3" style="max-height: 160px; object-fit: contain;" />
                                    </a>
                                    <h6 class="card-title fw-bold text-dark small text-truncate-2 mt-2 mb-1" style="min-height: 38px; font-size: 13px;" title="@item.Name">
                                        <a asp-action="ProductDetail" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Name</a>
                                    </h6>
                                    <span class="fw-bold fs-6 my-1 d-block" style="color: #004b91;">@item.Price.ToString("N0")đ</span>
                                </div>

                                <!-- 2 NÚT BẤM CẠNH NHAU: THÊM GIỎ HÀNG & MUA NGAY -->
                                <div class="d-flex gap-1 mt-2">
                                    <form asp-action="AddToCart" method="post" class="flex-grow-1">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-primary w-100 py-1 py-md-2 rounded-3 text-nowrap" style="font-size: 11px;" title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus me-1"></i>Thêm giỏ
                                        </button>
                                    </form>

                                    <form asp-action="BuyNow" method="post" class="flex-grow-1">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <button type="submit" class="btn btn-vnm w-100 py-1 py-md-2 rounded-3 text-nowrap fw-bold" style="font-size: 11px;" title="Mua ngay">
                                            Mua ngay
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-box-seam fs-1 text-muted d-block mb-2"></i>
                        <span class="text-muted small">Không tìm thấy sản phẩm nào.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>