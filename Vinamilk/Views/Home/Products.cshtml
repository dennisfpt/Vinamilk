@model IEnumerable<Vinamilk.Models.Entities.Product>
@{
    ViewData["Title"] = "Sản phẩm Vinamilk";
}

<style>
    .vnm-products-page {
        background-color: #FFFFF1;
        color: #0213B0;
        padding: 40px 0 70px;
    }

    .vnm-product-item {
        background-color: #ffffff;
        border: 1px solid rgba(2, 19, 176, 0.12);
        border-radius: 10px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }

        .vnm-product-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(2, 19, 176, 0.1);
        }

    .btn-vnm-buy {
        background-color: #0213B0;
        color: #ffffff;
        font-weight: 700;
        border-radius: 6px;
        border: none;
        padding: 9px 16px;
        transition: opacity 0.2s;
    }

        .btn-vnm-buy:hover {
            opacity: 0.9;
            color: #ffffff;
        }
</style>

<div class="vnm-products-page">
    <div class="container">
        <!-- Tiêu đề & Ô tìm kiếm trực tiếp trên trang Sản phẩm -->
        <div class="row align-items-center justify-content-between g-3 mb-4">
            <div class="col-md-6">
                <h1 class="fw-bold display-6 mb-1" style="color: #0213B0;">Tất cả sản phẩm</h1>
                <p class="small mb-0 opacity-75">Dinh dưỡng chuẩn quốc tế cho cả gia đình Việt</p>
            </div>

            <div class="col-md-5">
                <form asp-controller="Home" asp-action="Products" method="get" class="d-flex gap-2">
                    <input type="text" name="keyword" value="@ViewBag.SearchKeyword"
                           class="form-control"
                           placeholder="Nhập tên sữa cần tìm (Dielac, Grow, Phô mai...)"
                           style="background-color: #EBF0F7; border: none; border-bottom: 1.5px solid #0213B0; color: #0213B0;" />
                    <button type="submit" class="btn btn-vnm-buy px-4">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Thanh thông báo khi đang lọc theo từ khóa tìm kiếm -->
        @if (ViewBag.SearchKeyword != null)
        {
            <div class="d-flex align-items-center justify-content-between p-3 mb-4 rounded-3" style="background-color: #EBF0F7; color: #0213B0;">
                <div>
                    Kết quả tìm kiếm cho từ khóa: <strong>"@ViewBag.SearchKeyword"</strong>
                    <span class="ms-2 small opacity-75">(@(Model?.Count() ?? 0) sản phẩm)</span>
                </div>
                <a asp-controller="Home" asp-action="Products" class="btn btn-sm btn-vnm-buy">
                    Xem tất cả
                </a>
            </div>
        }

        <!-- Lưới sản phẩm -->
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card h-100 vnm-product-item">
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id" class="p-3 text-center d-block bg-white">
                                <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" style="height: 200px; object-fit: contain;" />
                            </a>

                            <div class="card-body d-flex flex-column pt-2">
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id" class="text-decoration-none">
                                    <h6 class="fw-bold mb-2" style="color: #0213B0; min-height: 42px; line-height: 1.35;">
                                        @item.Name
                                    </h6>
                                </a>

                                <div class="mt-auto">
                                    <div class="fw-bold fs-5 mb-3" style="color: #0213B0;">
                                        @item.Price.ToString("N0")đ
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id" class="btn btn-vnm-buy flex-grow-1 text-center">
                                            Chọn mua
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5" style="color: #0213B0;">
                <i class="bi bi-search fs-1 opacity-50 d-block mb-2"></i>
                <h5 class="fw-bold">Không tìm thấy sản phẩm phù hợp</h5>
                <p class="small opacity-75">Thử tìm với từ khóa khác như "Dielac", "Grow", "Phô mai"...</p>
                <a asp-controller="Home" asp-action="Products" class="btn btn-vnm-buy mt-2">Quay lại danh sách sản phẩm</a>
            </div>
        }
    </div>
</div>