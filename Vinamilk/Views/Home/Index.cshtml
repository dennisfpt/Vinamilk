@model IEnumerable<Vinamilk.Models.Entities.Product>
@{
    ViewData["Title"] = "Vinamilk - Vươn Cao Việt Nam";
}

<style>
    /* Khối 1: Hero Banner Vinamilk Rewards nền caro xanh */
    .vnm-rewards-hero {
        background-color: #0213B0;
        background-image: url('/images/rewards-bg.jpg');
        background-size: cover;
        background-position: center bottom;
        background-repeat: no-repeat;
        min-height: 540px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 75px;
        text-align: center;
        color: #ffffff;
    }

    .vnm-rewards-subtitle {
        font-family: 'VNM Sans Display', serif;
        font-style: italic;
        font-size: 1.25rem;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
        opacity: 0.95;
    }

    .vnm-rewards-title {
        font-family: 'VNM Sans Display', sans-serif !important;
        font-weight: 700;
        font-size: clamp(2.4rem, 5vw, 3.8rem);
        line-height: 1.1;
        color: #ffffff !important;
        margin-bottom: 28px;
    }

    .btn-vnm-white {
        background-color: #FFFFF1;
        color: #0213B0;
        font-family: 'VNM Sans Display', sans-serif;
        font-weight: 700;
        padding: 12px 32px;
        border-radius: 6px;
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-vnm-white:hover {
        background-color: #ffffff;
        color: #0213B0;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    /* Khối 2: Tận hưởng dễ dàng (3 cột có vạch kẻ dọc) */
    .vnm-step-col {
        border-right: 1px solid rgba(2, 19, 176, 0.15);
    }
    .vnm-step-col:last-child {
        border-right: none;
    }
    @@media (max-width: 767px) {
        .vnm-step-col {
            border-right: none;
            border-bottom: 1px solid rgba(2, 19, 176, 0.15);
            padding-bottom: 24px;
        }
    }

    .vnm-gift-bar {
        background-color: #D1F2EB;
        border-radius: 6px;
        padding: 18px 24px;
    }
</style>

<!-- 1. HERO BANNER NỀN CARO SẠCH (KHÔNG CHỮ ĐÈ LÊN) -->
<section class="vnm-rewards-hero" style="min-height: 520px;"></section>

<!-- ===================================================================== -->
<!-- 2. KHỐI "TẬN HƯỞNG DỄ DÀNG" (3 BƯỚC + BANNER TẶNG 5.000 ĐIỂM)         -->
<!-- ===================================================================== -->
<section class="py-5" style="background-color: #FFFFF1;">
    <div class="container py-3">
        <h2 class="text-center fw-bold display-6 mb-5" style="color: #0213B0;">
            Tận hưởng dễ dàng
        </h2>

        <div class="row g-4 mb-5">
            <!-- Bước 01 -->
            <div class="col-md-4 px-lg-4 vnm-step-col">
                <div class="text-center mb-4">
                    <img src="/images/step-1-register.jpg" alt="Đăng ký Vinamilk Rewards" class="img-fluid" style="height: 210px; object-fit: contain;" />
                </div>
                <div class="small fw-bold mb-1" style="color: #0213B0;">01</div>
                <h4 class="fw-bold fst-italic mb-2" style="color: #0213B0;">Đăng ký</h4>
                <p class="small mb-0" style="color: #0213B0; opacity: 0.85;">
                    Dễ dàng tham gia Vinamilk Rewards với chính tài khoản mua hàng tại Vinamilk Shop
                </p>
            </div>

            <!-- Bước 02 -->
            <div class="col-md-4 px-lg-4 vnm-step-col">
                <div class="text-center mb-4">
                    <img src="/images/step-2-points.jpg" alt="Tích điểm" class="img-fluid" style="height: 210px; object-fit: contain;" />
                </div>
                <div class="small fw-bold mb-1" style="color: #0213B0;">02</div>
                <h4 class="fw-bold fst-italic mb-2" style="color: #0213B0;">Tích điểm</h4>
                <p class="small mb-0" style="color: #0213B0; opacity: 0.85;">
                    Đến <strong>4%</strong> cho mỗi Đơn hàng tại Vinamilk và khi tham gia các hoạt động của Vinamilk Rewards
                </p>
            </div>

            <!-- Bước 03 -->
            <div class="col-md-4 px-lg-4 vnm-step-col">
                <div class="text-center mb-4">
                    <img src="/images/step-3-redeem.jpg" alt="Đổi điểm và tận hưởng" class="img-fluid" style="height: 210px; object-fit: contain;" />
                </div>
                <div class="small fw-bold mb-1" style="color: #0213B0;">03</div>
                <h4 class="fw-bold fst-italic mb-2" style="color: #0213B0;">Đổi điểm &amp; tận hưởng</h4>
                <p class="small mb-0" style="color: #0213B0; opacity: 0.85;">
                    Dễ dàng đổi điểm tích lũy thành Coupon giảm giá và quà tặng miễn phí
                </p>
            </div>
        </div>

        <!-- Thanh Banner Tặng 5.000 Điểm -->
        <div class="vnm-gift-bar d-flex flex-wrap justify-content-center align-items-center gap-3 text-center">
            <span style="color: #0213B0; font-size: 1.05rem;">
                <i class="bi bi-gift me-2"></i> Tặng <strong>5.000 Điểm</strong> khi đăng ký hôm nay
            </span>
            <a asp-controller="Account" asp-action="Register" class="btn btn-vnm-primary px-4 py-2">
                Đăng ký ngay
            </a>
        </div>
    </div>
</section>

<!-- ===================================================================== -->
<!-- 3. KHỐI "MỜI BẠN SẮM SỬA" (DẢI SẢN PHẨM NỔI BẬT ĐẶC TRƯNG)            -->
<!-- ===================================================================== -->
<!-- 3. KHỐI "MỜI BẠN SẮM SỬA" (HIỂN THỊ FULL ẢNH) -->
<section class="pt-4 pb-0" style="background-color: #FFFFF1;">
    <div class="container text-center">
        <a asp-controller="Home" asp-action="Products">
            <img src="/images/moi-ban-sam-sua.png"
                 alt="Mời bạn sắm sửa Vinamilk"
                 class="img-fluid w-100" />
        </a>
    </div>
</section>