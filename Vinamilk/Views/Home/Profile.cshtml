@model List<Vinamilk.Models.Entities.Order>
@{
    ViewData["Title"] = "Tài khoản người dùng";
}

<div class="container py-4" style="max-width: 1000px;">
    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN TÀI KHOẢN -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 28px;">
                    <i class="bi bi-person"></i>
                </div>
                <h6 class="fw-bold text-dark mb-0 text-break">@ViewBag.UserEmail</h6>
                <small class="text-muted">Khách hàng thành viên</small>

                <div class="list-group list-group-flush text-start small mt-4">
                    <a href="javascript:void(0)" class="list-group-item list-group-item-action border-0 px-3 py-2 rounded-3 text-muted">
                        <i class="bi bi-person me-2"></i>Thông tin cá nhân
                    </a>
                    <a href="javascript:void(0)" class="list-group-item list-group-item-action border-0 px-3 py-2 rounded-3 fw-bold text-primary bg-primary bg-opacity-10">
                        <i class="bi bi-receipt me-2"></i>Lịch sử đơn hàng
                    </a>
                    <a href="javascript:void(0)" class="list-group-item list-group-item-action border-0 px-3 py-2 rounded-3 text-muted">
                        <i class="bi bi-geo-alt me-2"></i>Địa chỉ nhận hàng
                    </a>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: LỊCH SỬ ĐƠN HÀNG ĐỘNG -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">Lịch sử đơn hàng đã đặt</h6>
                    <span class="badge bg-light text-secondary border rounded-pill">Tổng: @Model.Count đơn</span>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i> 
                        Bạn chưa có đơn hàng nào tại Vinamilk.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th>MÃ ĐƠN</th>
                                    <th>NGÀY ĐẶT</th>
                                    <th>TỔNG TIỀN</th>
                                    <th>TRẠNG THÁI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">#@order.Id</td>
                                        <td class="text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fw-bold text-primary">@order.TotalAmount.ToString("N0")đ</td>
                                        <td>
                                            <!-- MÀU VÀ CHỮ ĐỒNG BỘ ĐỘNG THEO ADMIN VÀ DATABASE -->
                                            @{
                                                var st = order.Status ?? string.Empty;
                                                var badgeClass = "bg-warning bg-opacity-10 text-dark border-warning";

                                                if (st.Contains("Hoàn thành"))
                                                {
                                                    badgeClass = "bg-success bg-opacity-10 text-success border-success";
                                                }
                                                else if (st.Contains("Đang giao"))
                                                {
                                                    badgeClass = "bg-primary bg-opacity-10 text-primary border-primary";
                                                }
                                                else if (st.Contains("Đã hủy"))
                                                {
                                                    badgeClass = "bg-danger bg-opacity-10 text-danger border-danger";
                                                }
                                                else if (st.Contains("Đã thanh toán") || st.Contains("Chờ xác nhận"))
                                                {
                                                    badgeClass = "bg-info bg-opacity-10 text-info border-info";
                                                }
                                            }
                                            <span class="badge rounded-pill px-3 py-2 fw-semibold border @badgeClass" style="font-size: 11px;">
                                                @order.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>