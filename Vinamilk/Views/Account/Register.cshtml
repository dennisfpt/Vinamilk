@model Vinamilk.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="width: 100%; max-width: 440px;">
        <div class="text-center mb-3">
            <span class="fw-bold fs-3" style="color: #004b91;">Vinamilk</span>
            <h5 class="fw-bold text-dark mt-2 mb-1">Đăng ký tài khoản</h5>
            <p class="text-muted small">Tạo tài khoản để trải nghiệm mua sắm và nhận ưu đãi</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger small py-2">
                <div asp-validation-summary="All" class="text-danger mb-0"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="mb-3">
                <label class="form-label small text-muted mb-1">Họ và tên *</label>
                <input type="text" asp-for="FullName" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Nguyễn Văn An" required />
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted mb-1">Số điện thoại *</label>
                <input type="tel" asp-for="PhoneNumber" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="0912345678" maxlength="10" pattern="0[0-9]{9}" required />
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted mb-1">Email *</label>
                <input type="email" asp-for="Email" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="nguyenvanan@gmail.com" required />
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted mb-1">Mật khẩu *</label>
                <input type="password" asp-for="Password" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Tối thiểu 6 ký tự" minlength="6" required />
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted mb-1">Xác nhận mật khẩu *</label>
                <input type="password" asp-for="ConfirmPassword" class="form-control rounded-3 py-2 small bg-light border-0" placeholder="Nhập lại mật khẩu" minlength="6" required />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsSubscribed" id="promo" checked>
                <label class="form-check-label small text-muted" for="promo">Đăng ký nhận email khuyến mãi</label>
            </div>

            <button type="submit" class="btn text-white w-100 py-2 shadow-sm mb-3 rounded-pill fw-semibold" style="background-color: #004b91;">
                Đăng ký
            </button>

            <div class="text-center small text-muted">
                Đã có tài khoản? 
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="text-primary text-decoration-none fw-bold">
                    Đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>