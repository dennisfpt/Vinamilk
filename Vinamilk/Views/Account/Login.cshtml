@{
    ViewData["Title"] = "Đăng nhập tài khoản Vinamilk";
}

<style>
    .vnm-login-page {
        background-color: #FFFFF1;
        color: #0213B0;
        min-height: 85vh;
        padding: 50px 0 70px;
    }

    .vnm-login-container {
        max-width: 560px;
        margin: 0 auto;
    }

    .vnm-input-group {
        position: relative;
        margin-bottom: 18px;
    }

    .vnm-input {
        width: 100%;
        background-color: #EBF0F7 !important;
        border: none !important;
        border-bottom: 1.5px solid #0213B0 !important;
        border-radius: 2px 2px 0 0 !important;
        padding: 15px 42px 15px 16px !important;
        color: #0213B0 !important;
        font-size: 0.95rem;
        outline: none;
        transition: background-color 0.2s ease;
    }

    .vnm-input::placeholder {
        color: #0213B0;
        opacity: 0.75;
    }

    .vnm-input:focus {
        background-color: #e2e9f5 !important;
        box-shadow: none !important;
    }

    .vnm-eye-btn {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #0213B0;
        cursor: pointer;
        padding: 4px;
    }

    .vnm-checkbox {
        width: 18px;
        height: 18px;
        accent-color: #0213B0;
        cursor: pointer;
    }

    .vnm-submit-btn {
        width: 100%;
        background-color: #0213B0;
        color: #ffffff;
        font-family: 'VNM Sans Display', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px;
        border: none;
        border-radius: 6px;
        margin-top: 8px;
        transition: opacity 0.2s ease;
    }

    .vnm-submit-btn:hover {
        opacity: 0.9;
        color: #ffffff;
    }

    .vnm-dashed-border {
        height: 6px;
        width: 100%;
        margin-top: 40px;
        background-image: repeating-linear-gradient(
            to right,
            #0213B0 0px,
            #0213B0 16px,
            #38BDF8 16px,
            #38BDF8 32px
        );
    }
</style>

<div class="vnm-login-page">
    <div class="container">
        <div class="vnm-login-container">
            <!-- Tiêu đề đồng bộ trang Đăng ký -->
            <h1 class="fw-bold display-5 mb-2" style="color: #0213B0;">Đăng nhập</h1>
            <p class="mb-4" style="color: #0213B0; font-size: 1rem;">
                Chào mừng bạn quay trở lại với Vinamilk Rewards
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-2 small mb-3">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.Error
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <!-- Email hoặc số điện thoại -->
                <div class="vnm-input-group">
                    <input type="text" name="Email" class="vnm-input" placeholder="Email hoặc số điện thoại *" required />
                </div>

                <!-- Mật khẩu -->
                <div class="vnm-input-group mb-3">
                    <input type="password" id="LoginPassword" name="Password" class="vnm-input" placeholder="Nhập mật khẩu *" required />
                    <button type="button" class="vnm-eye-btn" onclick="toggleLoginPass('LoginPassword', this)" title="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye-slash fs-5"></i>
                    </button>
                </div>

                <!-- Nhớ đăng nhập & Quên mật khẩu -->
                <div class="d-flex justify-content-between align-items-center mb-4 small" style="color: #0213B0;">
                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
                        <input type="checkbox" name="RememberMe" value="true" class="vnm-checkbox" />
                        <span>Nhớ đăng nhập</span>
                    </label>
                    <a href="#" class="text-decoration-underline fw-semibold" style="color: #0213B0;">Quên mật khẩu?</a>
                </div>

                <!-- Nút Đăng nhập -->
                <button type="submit" class="vnm-submit-btn">
                    Đăng nhập
                </button>
            </form>

            <hr class="my-4" style="border-color: rgba(2, 19, 176, 0.2);" />
            <div class="text-center small" style="color: #0213B0;">
                Chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register" class="fw-bold text-decoration-underline ms-1" style="color: #0213B0;">
                    Đăng ký ngay
                </a>
            </div>

            <!-- Viền đứt đoạn đặc trưng dưới cùng -->
            <div class="vnm-dashed-border"></div>
        </div>
    </div>
</div>

<script>
    function toggleLoginPass(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        }
    }
</script>