@using Microsoft.AspNetCore.Identity
@using System.Text.Json
@inject SignInManager<IdentityUser> SignInManager

@{
    var notifSession = Context.Session.GetString("VinamilkUserNotifications");
    var notifications = string.IsNullOrEmpty(notifSession)
        ? new List<Vinamilk.Controllers.UserNotificationItem>()
        : JsonSerializer.Deserialize<List<Vinamilk.Controllers.UserNotificationItem>>(notifSession) ?? new List<Vinamilk.Controllers.UserNotificationItem>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vinamilk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --vnm-blue: #004b91;
            --vnm-hover: #003366;
            --vnm-cyan: #00a0e9;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #fbfbfb;
            color: #212529;
        }

        .top-brand {
            font-size: 28px;
            font-weight: 900;
            color: #004b91;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .search-box {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            width: 440px;
            padding: 6px 16px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            width: 100%;
        }

        .header-link {
            color: #334155;
            font-size: 13px;
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .header-link:hover {
            color: var(--vnm-blue);
        }

        .nav-menu-link {
            color: #475569;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            padding: 6px 14px;
        }

        .nav-menu-link:hover, .nav-menu-link.active {
            color: var(--vnm-blue);
            font-weight: 600;
        }

        .btn-vnm {
            background-color: #004b91;
            color: #fff;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            padding: 7px 20px;
            border: none;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s;
        }

        .btn-vnm:hover {
            background-color: var(--vnm-hover);
            color: #fff;
        }

        .product-card {
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            background: #fff;
            transition: transform 0.2s, box-shadow 0.2s;
            transform-style: preserve-3d;
            perspective: 1000px;
        }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.06);
        }

        /* TẠO CHIỀU SÂU 3D TỰ ĐỘNG CHO ẢNH VÀ NỘI DUNG SẢN PHẨM */
        .product-card img, .card.h-100 img {
            transform: translateZ(30px);
            transition: transform 0.3s ease;
        }

        .product-card .btn-vnm, .card.h-100 button, .card.h-100 .fw-bold {
            transform: translateZ(20px);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- HEADER 2 TẦNG CHUẨN -->
    <header class="sticky-top shadow-sm" style="background-color: #FFFFF1; border-bottom: 1px solid rgba(2, 19, 176, 0.12);">
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container">
                <!-- Logo Vinamilk EST 1976 mới -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/vinamilk-logo-new.png"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
                         alt="Vinamilk EST 1976"
                         style="height: 36px; object-fit: contain;" />
                    <span class="fw-bold fs-3" style="display:none; color: #0213B0; letter-spacing: -1px; font-family: 'VNM Sans Display', sans-serif;">
                        Vinamilk <small class="fs-6 fw-normal">EST 1976</small>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#vnmMainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="vnmMainNav">
                    <ul class="navbar-nav mx-auto gap-lg-3 fw-semibold" style="font-family: 'VNM Sans Display', sans-serif;">
                        <li class="nav-item">
                            <a class="nav-link" style="color: #0213B0;" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #0213B0;" asp-controller="Products" asp-action="Index">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #0213B0;" asp-controller="Home" asp-action="LandingPage">Khuyến mãi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #0213B0;" asp-controller="Home" asp-action="GreenFarmSurvey">Khảo sát</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #0213B0;" asp-controller="Home" asp-action="About">Về chúng tôi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #0213B0;" asp-controller="Home" asp-action="Stores">Cửa hàng</a>
                        </li>
                    </ul>

                    <!-- Cụm Tài khoản & Giỏ hàng -->
                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Cart" asp-action="Index" class="btn position-relative px-3 py-2" style="color: #0213B0; border: 1px solid #0213B0; border-radius: 6px;">
                            <i class="bi bi-bag-fill me-1"></i> Giỏ hàng
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.Identity.Name == "admin@vinamilk.com.vn")
                            {
                                <a asp-controller="Admin" asp-action="Index" class="btn btn-vnm-primary px-3 py-2">
                                    <i class="bi bi-speedometer2 me-1"></i> Quản trị
                                </a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-2">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold" style="color: #0213B0;">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-vnm-primary px-3 py-2">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-5">
        <div class="container text-center text-muted small">
            <p class="mb-1 fw-bold text-dark">VINAMILK - VƯƠN CAO VIỆT NAM</p>
            <p class="mb-0">Hệ sinh thái E-Commerce & Marketing Automation.</p>
        </div>
    </footer>

    <!-- WIDGET CHATBOT AI -->
    <div id="chatbot-widget" style="position: fixed; bottom: 25px; right: 25px; z-index: 1050;">
        <button id="chatbot-toggle-btn" class="btn btn-vnm rounded-circle shadow-lg d-flex align-items-center justify-content-center p-0" style="width: 54px; height: 54px;">
            <i class="bi bi-robot fs-4"></i>
        </button>

        <div id="chatbot-box" class="card border-0 shadow-lg rounded-4 d-none" style="width: 360px; height: 500px; position: absolute; bottom: 65px; right: 0; overflow: hidden;">
            <div class="card-header text-white py-3 d-flex justify-content-between align-items-center" style="background-color: #004b91;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-robot fs-5"></i>
                    <h6 class="mb-0 fw-bold" style="font-size: 14px;">Trợ lý Vinamilk AI</h6>
                </div>
                <button id="chatbot-close-btn" class="btn btn-sm text-white p-0"><i class="bi bi-x-lg"></i></button>
            </div>

            <div id="chat-messages" class="card-body p-3 overflow-auto" style="height: 330px; background-color: #f8fafc; font-size: 13px;">
                <div class="d-flex mb-2">
                    <div class="p-2 rounded-3 bg-white border shadow-sm" style="max-width: 85%;">
                        Vinamilk có nhiều dòng sản phẩm: Sữa tươi 100%, Sữa hạt, Sữa chua, Sữa bột Dielac, Sữa đặc Ông Thọ. Bạn muốn tìm hiểu loại nào ạ?
                    </div>
                </div>
            </div>

            <div class="px-2 py-1 bg-white border-top d-flex gap-1 overflow-auto">
                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 quick-ask" style="font-size: 11px;">Sữa tươi</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 quick-ask" style="font-size: 11px;">Sữa chua</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 quick-ask" style="font-size: 11px;">Sữa bột</button>
            </div>

            <div class="card-footer bg-white p-2 border-top">
                <div class="input-group">
                    <input type="text" id="chat-input" class="form-control border-0 bg-light rounded-pill px-3" style="font-size: 13px;" placeholder="Nhập câu hỏi..." />
                    <button id="chat-send-btn" class="btn btn-vnm rounded-circle ms-2 d-flex align-items-center justify-content-center p-0" style="width: 36px; height: 36px;"><i class="bi bi-send-fill" style="font-size: 12px;"></i></button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("chatbot-toggle-btn");
            const closeBtn = document.getElementById("chatbot-close-btn");
            const chatBox = document.getElementById("chatbot-box");
            const sendBtn = document.getElementById("chat-send-btn");
            const chatInput = document.getElementById("chat-input");
            const messages = document.getElementById("chat-messages");

            toggleBtn?.addEventListener("click", () => chatBox.classList.toggle("d-none"));
            closeBtn?.addEventListener("click", () => chatBox.classList.add("d-none"));

            document.querySelectorAll(".quick-ask").forEach(btn => {
                btn.addEventListener("click", function() {
                    chatInput.value = "Tư vấn cho tôi về " + this.innerText;
                    sendMsg();
                });
            });

            async function sendMsg() {
                const text = chatInput.value.trim();
                if (!text) return;
                messages.innerHTML += `<div class="d-flex justify-content-end mb-2"><div class="p-2 rounded-3 text-white shadow-sm" style="background:#004b91; max-width:85%;">${text}</div></div>`;
                chatInput.value = "";
                messages.scrollTop = messages.scrollHeight;

                const loadId = "load-" + Date.now();
                messages.innerHTML += `<div id="${loadId}" class="d-flex mb-2"><div class="p-2 rounded-3 bg-white border text-muted small">Đang phản hồi...</div></div>`;
                messages.scrollTop = messages.scrollHeight;

                try {
                    const res = await fetch('/api/chatbot/ask', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ message: text })
                    });
                    const d = await res.json();
                    document.getElementById(loadId)?.remove();
                    messages.innerHTML += `<div class="d-flex mb-2"><div class="p-2 rounded-3 bg-white border shadow-sm" style="max-width:85%;">${d.reply.replace(/\n/g, '<br>')}</div></div>`;
                } catch {
                    document.getElementById(loadId)?.remove();
                    messages.innerHTML += `<div class="d-flex mb-2"><div class="p-2 rounded-3 bg-white border shadow-sm" style="max-width:85%;">Sản phẩm chất lượng cao của Vinamilk luôn đảm bảo tiêu chuẩn quốc tế và dinh dưỡng toàn diện!</div></div>`;
                }
                messages.scrollTop = messages.scrollHeight;
            }

            sendBtn?.addEventListener("click", sendMsg);
            chatInput?.addEventListener("keypress", (e) => { if (e.key === 'Enter') sendMsg(); });
        });
    </script>

    <!-- THƯ VIỆN & SCRIPT TẠO CHUYỂN ĐỘNG 3D CHO TẤT CẢ SẢN PHẨM -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tự động tìm tất cả card sản phẩm trên trang (kể cả sản phẩm mới do Admin thêm vào)
            const productElements = document.querySelectorAll('.product-card, .card.h-100');
            if (productElements.length > 0 && typeof VanillaTilt !== "undefined") {
                VanillaTilt.init(productElements, {
                    max: 15,            // Góc nghiêng tối đa
                    speed: 400,         // Tốc độ phản hồi (ms)
                    glare: true,        // Hiệu ứng bóng phản quang
                    "max-glare": 0.2,   // Độ mờ của bóng phản quang
                    scale: 1.03         // Phóng to nhẹ khi hover
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>