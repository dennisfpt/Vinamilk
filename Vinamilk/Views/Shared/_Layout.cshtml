@using Microsoft.AspNetCore.Identity
@using System.Text.Json
@inject SignInManager<IdentityUser> SignInManager

@{
    var notifSession = Context.Session.GetString("VinamilkUserNotifications");
    var notifications = string.IsNullOrEmpty(notifSession)
        ? new List<Vinamilk.Controllers.UserNotificationItem>()
        : JsonSerializer.Deserialize<List<Vinamilk.Controllers.UserNotificationItem>>(notifSession) ?? new List<Vinamilk.Controllers.UserNotificationItem>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vinamilk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --vnm-blue: #0213B0;
            --vnm-hover: #000d80;
            --vnm-cream: #FFFFF1;
            --vnm-cyan: #00a0e9;
        }

        body {
            font-family: 'VNM Sans Std', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--vnm-cream);
            color: var(--vnm-blue);
        }

        h1, h2, h3, h4, h5, h6, .top-brand, .btn-vnm {
            font-family: 'VNM Sans Display', sans-serif;
        }

        .top-brand {
            font-size: 28px;
            font-weight: 900;
            color: var(--vnm-blue);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .search-box {
            background: #EBF0F7;
            border: 1px solid rgba(2, 19, 176, 0.2);
            border-radius: 20px;
            width: 440px;
            padding: 6px 16px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            color: var(--vnm-blue);
            width: 100%;
        }

        .search-box input::placeholder {
            color: rgba(2, 19, 176, 0.65);
        }

        .header-link {
            color: var(--vnm-blue);
            font-size: 13px;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .header-link:hover {
            opacity: 0.8;
            color: var(--vnm-blue);
        }

        .nav-menu-link {
            color: var(--vnm-blue);
            font-size: 13.5px;
            font-weight: 600;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .nav-menu-link:hover, .nav-menu-link.active {
            background-color: rgba(2, 19, 176, 0.08);
            color: var(--vnm-blue);
            font-weight: 700;
        }

        .btn-vnm {
            background-color: var(--vnm-blue);
            color: #fff;
            border-radius: 20px;
            font-weight: 700;
            font-size: 13px;
            padding: 7px 20px;
            border: none;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s;
        }

        .btn-vnm:hover {
            background-color: var(--vnm-hover);
            color: #fff;
        }

        .product-card {
            border: 1px solid rgba(2, 19, 176, 0.1);
            border-radius: 12px;
            background: #fff;
            transition: transform 0.2s, box-shadow 0.2s;
            transform-style: preserve-3d;
            perspective: 1000px;
        }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(2, 19, 176, 0.08);
        }

        /* TẠO CHIỀU SÂU 3D TỰ ĐỘNG CHO ẢNH VÀ NỘI DUNG SẢN PHẨM */
        .product-card img, .card.h-100 img {
            transform: translateZ(30px);
            transition: transform 0.3s ease;
        }

        .product-card .btn-vnm, .card.h-100 button, .card.h-100 .fw-bold {
            transform: translateZ(20px);
        }

        /* FOOTER CHUẨN NHẬN DIỆN VINAMILK */
        .vnm-footer {
            background-color: #FFFFF1;
            color: #0213B0;
            border-top: 1px solid rgba(2, 19, 176, 0.15);
            padding: 56px 0 36px;
            font-size: 0.85rem;
            margin-top: 3rem;
        }

        .vnm-footer-heading {
            font-weight: 700;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #0213B0;
            margin-bottom: 14px;
        }

        .vnm-footer-info p {
            margin-bottom: 6px;
            line-height: 1.55;
            color: #0213B0;
        }

        .vnm-footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .vnm-footer-links li {
            margin-bottom: 9px;
        }

        .vnm-footer-links a {
            color: #0213B0;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        .vnm-footer-links a:hover {
            text-decoration: underline;
            opacity: 0.8;
        }

        .vnm-social-btn {
            width: 34px;
            height: 34px;
            border: 1.5px solid #0213B0;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #0213B0;
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .vnm-social-btn:hover {
            background-color: #0213B0;
            color: #FFFFF1;
        }

        .vnm-lang-select {
            border: 1px solid rgba(2, 19, 176, 0.45);
            background-color: transparent;
            color: #0213B0;
            border-radius: 6px;
            padding: 6px 14px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .vnm-bct-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 6px;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.72rem;
            line-height: 1.15;
            text-decoration: none;
            min-width: 145px;
        }

        .vnm-bct-badge:hover {
            color: #ffffff;
            opacity: 0.92;
        }

        .vnm-bct-red {
            background-color: #D9232E;
        }

        .vnm-bct-blue {
            background-color: #1B75BC;
        }

        .vnm-footer-bottom {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid rgba(2, 19, 176, 0.12);
            font-size: 0.78rem;
            line-height: 1.65;
            color: #0213B0;
        }

        .vnm-footer-bottom a {
            color: #0213B0;
            text-decoration: underline;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- HEADER 2 TẦNG CHUẨN NHẬN DIỆN MỚI -->
    <header class="border-bottom sticky-top shadow-sm" style="background-color: #FFFFF1; border-color: rgba(2, 19, 176, 0.15) !important;">
        <div class="container py-2 d-flex align-items-center justify-content-between">
            <!-- LOGO MỚI -->
            <a asp-controller="Home" asp-action="Index" class="top-brand d-flex align-items-center">
                <img src="~/images/vinamilk-logo-new.png"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
                     alt="Vinamilk EST 1976"
                     style="height: 36px; object-fit: contain;" />
                <span style="display:none;">
                    Vinamilk<span style="font-size: 11px; font-weight: normal; vertical-align: super; margin-left: 2px;">EST 1976</span>
                </span>
            </a>

            <!-- THANH TÌM KIẾM -->
            <form asp-controller="Home" asp-action="Products" method="get" class="search-box d-none d-md-flex align-items-center">
                <input type="text" name="keyword" value="@Context.Request.Query["keyword"]" placeholder="Tìm kiếm sản phẩm..." />
                <button type="submit" class="border-0 bg-transparent" style="color: #0213B0;"><i class="bi bi-search"></i></button>
            </form>

            <div class="d-flex align-items-center gap-3">
                <!-- QUẢ CHUÔNG THÔNG BÁO CHO KHÁCH HÀNG -->
                <div class="dropdown position-relative">
                    <a href="#" class="header-link position-relative p-2 rounded-circle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell-fill fs-5" style="color: #0213B0;"></i>
                        @if (notifications.Any())
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" style="font-size: 10px;">
                                @notifications.Count
                            </span>
                        }
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2" style="width: 340px; max-height: 400px; overflow-y: auto;">
                        <li class="d-flex flex-column gap-2 px-3 py-2 border-bottom">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark small">Thông báo của bạn</h6>
                                <span class="badge bg-primary bg-opacity-10 text-primary small">@notifications.Count mới</span>
                            </div>
                            <a asp-controller="Admin" asp-action="Surveys" class="btn btn-outline-success btn-sm rounded-pill">
                                <i class="bi bi-bar-chart-line me-1"></i> Báo cáo Khảo sát Green Farm
                            </a>
                        </li>
                        @if (notifications.Any())
                        {
                            foreach (var item in notifications)
                            {
                                <li class="p-2 border-bottom border-light">
                                    <div class="d-flex gap-2 align-items-start">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
                                            <i class="bi @item.Icon text-primary" style="font-size: 14px;"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <span class="d-block fw-semibold text-dark" style="font-size: 12px;">@item.Title</span>
                                            <small class="text-secondary d-block" style="font-size: 11px; line-height: 1.4;">@item.Message</small>
                                            <span class="text-muted d-block mt-1" style="font-size: 10px;"><i class="bi bi-clock me-1"></i>@item.TimeAgo</span>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="text-center py-4 text-muted small">
                                <i class="bi bi-bell-slash fs-3 d-block mb-1 text-secondary opacity-50"></i>
                                Chưa có thông báo mới.
                            </li>
                        }
                    </ul>
                </div>

                <!-- TÀI KHOẢN -->
                @if (SignInManager.IsSignedIn(User))
                {
                    var rawName = User.Identity?.Name ?? "Khách hàng";
                    var displayName = Context.Session.GetString("UserFullName");
                    if (string.IsNullOrEmpty(displayName))
                    {
                        displayName = rawName.Contains("@") ? rawName.Split('@')[0] : rawName;
                    }

                    <div class="dropdown">
                        <a class="header-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown" style="font-size: 13px;">
                            <i class="bi bi-person-circle fs-5" style="color: #0213B0;"></i>
                            <span>@displayName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                            <li><a class="dropdown-item small" asp-controller="Home" asp-action="Profile"><i class="bi bi-person me-2"></i>Tài khoản</a></li>
                            @if (rawName == "admin@vinamilk.com.vn")
                            {
                                <li><a class="dropdown-item small text-primary fw-bold" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Trang Quản Trị</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="header-link">
                        <i class="bi bi-person fs-5"></i>
                        <span>Đăng nhập</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-vnm py-1 px-3">
                        Đăng ký
                    </a>
                }

                <!-- GIỎ HÀNG -->
                <a asp-controller="Home" asp-action="Cart" class="header-link">
                    <i class="bi bi-bag fs-5"></i>
                    <span>Giỏ hàng</span>
                </a>
            </div>
        </div>

        <!-- TẦNG MENU ĐIỀU HƯỚNG (GIỮ NGUYÊN 100% CONTROLLER="HOME") -->
        <div class="container d-flex flex-wrap align-items-center gap-2 py-2 border-top" style="border-color: rgba(2, 19, 176, 0.1) !important;">
            <a asp-controller="Home" asp-action="Index" class="nav-menu-link">Trang chủ</a>
            <a asp-controller="Home" asp-action="Products" class="nav-menu-link">Sản phẩm</a>
            <a asp-controller="Home" asp-action="LandingPage" class="nav-menu-link">Khuyến mãi</a>
            <a asp-controller="Home" asp-action="About" class="nav-menu-link">Giới thiệu</a>
            <a asp-controller="Home" asp-action="News" class="nav-menu-link">Tin tức</a>
            <a asp-controller="Home" asp-action="Stores" class="nav-menu-link">Liên hệ / Cửa hàng</a>
            <a asp-controller="Home" asp-action="GreenFarmSurvey" class="nav-menu-link" style="color: #1b5e20;">
                <i class="bi bi-patch-question me-1"></i> Khảo sát Green Farm
            </a>
        </div>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER CHUẨN NHẬN DIỆN VINAMILK -->
    <footer class="vnm-footer">
        <div class="container">
            <!-- Hàng 1: Thông tin công ty + 6 cột danh mục -->
            <div class="row g-4">
                <div class="col-lg-3 col-md-12 vnm-footer-info pe-lg-4">
                    <div class="vnm-footer-heading">CÔNG TY CỔ PHẦN SỮA VIỆT NAM</div>
                    <p>Địa chỉ trụ sở: 10 Tân Trào, Phường Tân Mỹ, Thành phố Hồ Chí Minh</p>
                    <p class="mt-3">Đại diện pháp luật: Mai Kiều Liên</p>
                    <p>Điện thoại: 1900 636 979</p>
                    <p>Fax: (028) 5416 1226</p>
                    <p>Email: vinamilk@vinamilk.com.vn</p>
                    <p>MST: 0300588569</p>
                </div>

                <div class="col-lg-9 col-md-12">
                    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
                        <div class="col">
                            <div class="vnm-footer-heading">SẮM SỬA</div>
                            <ul class="vnm-footer-links">
                                <li><a asp-controller="Home" asp-action="Products">Bán chạy</a></li>
                                <li><a asp-controller="Home" asp-action="LandingPage">Ưu đãi</a></li>
                                <li><a asp-controller="Home" asp-action="Stores">Cửa hàng</a></li>
                                <li><a asp-controller="Home" asp-action="Products">Công bố</a></li>
                            </ul>
                        </div>

                        <div class="col">
                            <div class="vnm-footer-heading">LUÔN ĐỂ TÂM</div>
                            <ul class="vnm-footer-links">
                                <li><a asp-controller="Home" asp-action="About">Bền vững</a></li>
                                <li><a asp-controller="Home" asp-action="About">Công nghệ</a></li>
                                <li><a asp-controller="Home" asp-action="GreenFarmSurvey">Nghiên cứu</a></li>
                            </ul>
                        </div>

                        <div class="col">
                            <div class="vnm-footer-heading">LUÔN LÀ VINAMILK</div>
                            <ul class="vnm-footer-links">
                                <li><a asp-controller="Home" asp-action="About">Từ 1976</a></li>
                                <li><a asp-controller="Home" asp-action="About">Người dẫn đường</a></li>
                                <li><a asp-controller="Home" asp-action="About">Cùng một nhà</a></li>
                                <li><a asp-controller="Home" asp-action="About">Chất Vinamilk</a></li>
                            </ul>
                        </div>

                        <div class="col">
                            <div class="vnm-footer-heading">LUÔN VUI KHỎE</div>
                            <ul class="vnm-footer-links">
                                <li><a asp-controller="Home" asp-action="News">Đẹp da - Đẹp dáng</a></li>
                                <li><a asp-controller="Home" asp-action="News">Thông tin dinh dưỡng</a></li>
                                <li><a asp-controller="Home" asp-action="News">Góc chuyên gia</a></li>
                                <li><a asp-controller="Home" asp-action="News">Công thức món ngon</a></li>
                            </ul>
                        </div>

                        <div class="col">
                            <div class="vnm-footer-heading">LUÔN CÙNG BẠN</div>
                            <ul class="vnm-footer-links">
                                <li><a asp-controller="Home" asp-action="News">Truyền thông</a></li>
                                <li><a asp-controller="Home" asp-action="News">Tin tức &amp; Sự kiện</a></li>
                                <li><a asp-controller="Home" asp-action="About">Quan hệ Nhà đầu tư</a></li>
                                <li><a asp-controller="Home" asp-action="About">Mời vào đội</a></li>
                                <li><a asp-controller="Home" asp-action="Stores">Liên hệ</a></li>
                            </ul>
                        </div>

                        <div class="col">
                            <div class="vnm-footer-heading">LUÔN HỖ TRỢ</div>
                            <ul class="vnm-footer-links">
                                <li><a asp-controller="Home" asp-action="About">Đổi trả</a></li>
                                <li><a asp-controller="Home" asp-action="Checkout">Thanh toán</a></li>
                                <li><a asp-controller="Home" asp-action="Cart">Giao hàng</a></li>
                                <li><a asp-controller="Home" asp-action="LandingPage">Nhận quà</a></li>
                                <li><a asp-controller="Home" asp-action="Profile">Tra cứu hoá đơn</a></li>
                                <li><a asp-controller="Home" asp-action="About">Chính sách khác</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hàng 2: Mạng xã hội bên trái + Ngôn ngữ & Huy hiệu Bộ Công Thương bên phải -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-5">
                <div class="d-flex align-items-center gap-2">
                    <a href="https://www.facebook.com/vinamilkofficial" target="_blank" class="vnm-social-btn" aria-label="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="https://www.instagram.com/vinamilk.official" target="_blank" class="vnm-social-btn" aria-label="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="https://www.linkedin.com/company/vinamilk" target="_blank" class="vnm-social-btn" aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                    <a href="https://www.tiktok.com/@@vinamilkofficial" target="_blank" class="vnm-social-btn" aria-label="TikTok">
                        <i class="bi bi-tiktok"></i>
                    </a>
                    <a href="https://www.youtube.com/user/vinamilk" target="_blank" class="vnm-social-btn" aria-label="YouTube">
                        <i class="bi bi-youtube"></i>
                    </a>
                    <a href="https://www.threads.net" target="_blank" class="vnm-social-btn" aria-label="Threads">
                        <i class="bi bi-threads"></i>
                    </a>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <select class="vnm-lang-select" aria-label="Chọn ngôn ngữ">
                        <option selected>Tiếng Việt</option>
                        <option>English</option>
                    </select>

                    <div class="d-flex flex-column gap-2">
                        <a href="http://online.gov.vn" target="_blank" class="vnm-bct-badge vnm-bct-red">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>ĐÃ ĐĂNG KÝ<br /><small style="font-size: 0.6rem; font-weight: 500;">BỘ CÔNG THƯƠNG</small></span>
                        </a>
                        <a href="http://online.gov.vn" target="_blank" class="vnm-bct-badge vnm-bct-blue">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>ĐÃ THÔNG BÁO<br /><small style="font-size: 0.6rem; font-weight: 500;">BỘ CÔNG THƯƠNG</small></span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Hàng 3: Thông tin bản quyền & Giấy phép kinh doanh -->
            <div class="vnm-footer-bottom">
                <div>
                    Bản quyền thuộc về Vinamilk © 2025
                    <a asp-controller="Home" asp-action="About">Điều khoản sử dụng</a> |
                    <a asp-controller="Home" asp-action="About">Chính sách bảo mật</a> |
                    <a asp-controller="Home" asp-action="About">Quy chế hoạt động</a> |
                    <a asp-controller="Home" asp-action="About">Quy trình giải quyết khiếu nại</a>
                </div>
                <div>
                    Số giấy chứng nhận đăng ký doanh nghiệp: 0300588569. Cấp lần đầu ngày: 20/11/2003. Nơi cấp: Sở Tài chính Thành phố Hồ Chí Minh
                </div>
                <div>
                    Giấy phép kinh doanh hoạt động mua bán hàng hóa và các hoạt động liên quan trực tiếp đến mua bán hàng hóa số: 0300588569/KD-0956. Cấp lần đầu ngày 25/06/2024. Nơi cấp: Sở Công thương TP. Hồ Chí Minh.
                </div>
            </div>
        </div>
    </footer>

    <!-- WIDGET CHATBOT AI -->
    <div id="chatbot-widget" style="position: fixed; bottom: 25px; right: 25px; z-index: 1050;">
        <button id="chatbot-toggle-btn" class="btn btn-vnm rounded-circle shadow-lg d-flex align-items-center justify-content-center p-0" style="width: 54px; height: 54px;">
            <i class="bi bi-robot fs-4"></i>
        </button>

        <div id="chatbot-box" class="card border-0 shadow-lg rounded-4 d-none" style="width: 360px; height: 500px; position: absolute; bottom: 65px; right: 0; overflow: hidden;">
            <div class="card-header text-white py-3 d-flex justify-content-between align-items-center" style="background-color: #0213B0;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-robot fs-5"></i>
                    <h6 class="mb-0 fw-bold text-white" style="font-size: 14px;">Trợ lý Vinamilk AI</h6>
                </div>
                <button id="chatbot-close-btn" class="btn btn-sm text-white p-0"><i class="bi bi-x-lg"></i></button>
            </div>

            <div id="chat-messages" class="card-body p-3 overflow-auto" style="height: 330px; background-color: #FFFFF1; font-size: 13px;">
                <div class="d-flex mb-2">
                    <div class="p-2 rounded-3 bg-white border shadow-sm text-dark" style="max-width: 85%;">
                        Vinamilk có nhiều dòng sản phẩm: Sữa tươi 100%, Sữa hạt, Sữa chua, Sữa bột Dielac, Sữa đặc Ông Thọ. Bạn muốn tìm hiểu loại nào ạ?
                    </div>
                </div>
            </div>

            <div class="px-2 py-1 bg-white border-top d-flex gap-1 overflow-auto">
                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 quick-ask" style="font-size: 11px;">Sữa tươi</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 quick-ask" style="font-size: 11px;">Sữa chua</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 quick-ask" style="font-size: 11px;">Sữa bột</button>
            </div>

            <div class="card-footer bg-white p-2 border-top">
                <div class="input-group">
                    <input type="text" id="chat-input" class="form-control border-0 bg-light rounded-pill px-3" style="font-size: 13px;" placeholder="Nhập câu hỏi..." />
                    <button id="chat-send-btn" class="btn btn-vnm rounded-circle ms-2 d-flex align-items-center justify-content-center p-0" style="width: 36px; height: 36px;"><i class="bi bi-send-fill" style="font-size: 12px;"></i></button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("chatbot-toggle-btn");
            const closeBtn = document.getElementById("chatbot-close-btn");
            const chatBox = document.getElementById("chatbot-box");
            const sendBtn = document.getElementById("chat-send-btn");
            const chatInput = document.getElementById("chat-input");
            const messages = document.getElementById("chat-messages");

            toggleBtn?.addEventListener("click", () => chatBox.classList.toggle("d-none"));
            closeBtn?.addEventListener("click", () => chatBox.classList.add("d-none"));

            document.querySelectorAll(".quick-ask").forEach(btn => {
                btn.addEventListener("click", function() {
                    chatInput.value = "Tư vấn cho tôi về " + this.innerText;
                    sendMsg();
                });
            });

            async function sendMsg() {
                const text = chatInput.value.trim();
                if (!text) return;
                messages.innerHTML += `<div class="d-flex justify-content-end mb-2"><div class="p-2 rounded-3 text-white shadow-sm" style="background:#0213B0; max-width:85%;">${text}</div></div>`;
                chatInput.value = "";
                messages.scrollTop = messages.scrollHeight;

                const loadId = "load-" + Date.now();
                messages.innerHTML += `<div id="${loadId}" class="d-flex mb-2"><div class="p-2 rounded-3 bg-white border text-muted small">Đang phản hồi...</div></div>`;
                messages.scrollTop = messages.scrollHeight;

                try {
                    const res = await fetch('/api/chatbot/ask', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ message: text })
                    });
                    const d = await res.json();
                    document.getElementById(loadId)?.remove();
                    messages.innerHTML += `<div class="d-flex mb-2"><div class="p-2 rounded-3 bg-white border shadow-sm text-dark" style="max-width:85%;">${d.reply.replace(/\n/g, '<br>')}</div></div>`;
                } catch {
                    document.getElementById(loadId)?.remove();
                    messages.innerHTML += `<div class="d-flex mb-2"><div class="p-2 rounded-3 bg-white border shadow-sm text-dark" style="max-width:85%;">Sản phẩm chất lượng cao của Vinamilk luôn đảm bảo tiêu chuẩn quốc tế và dinh dưỡng toàn diện!</div></div>`;
                }
                messages.scrollTop = messages.scrollHeight;
            }

            sendBtn?.addEventListener("click", sendMsg);
            chatInput?.addEventListener("keypress", (e) => { if (e.key === 'Enter') sendMsg(); });
        });
    </script>

    <!-- THƯ VIỆN & SCRIPT TẠO CHUYỂN ĐỘNG 3D CHO TẤT CẢ SẢN PHẨM -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const productElements = document.querySelectorAll('.product-card, .card.h-100');
            if (productElements.length > 0 && typeof VanillaTilt !== "undefined") {
                VanillaTilt.init(productElements, {
                    max: 15,
                    speed: 400,
                    glare: true,
                    "max-glare": 0.2,
                    scale: 1.03
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>